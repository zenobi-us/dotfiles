amends "package://github.com/jdx/hk/releases/download/v1.50.0/hk@1.50.0#/Config.pkl"

hooks {
  ["pre-commit"] {
    fix = true
    stash = "none"
    stage = true
    steps {
      ["bundle-versions"] {
        check = "mise run checks:agent-bundle-versions -- check --staged"
        fix = "mise run checks:agent-bundle-versions -- fix --staged"
        stage = List("mise/conf.d/devtools-agent/bundles/*/.claude-plugin/plugin.json", "mise/conf.d/devtools-agent/bundles/.claude-plugin/marketplace.json")
        exclusive = true
      }
    }
  }

  ["check"] {
    steps {
      ["bundle-versions"] {
        check = "mise run checks:agent-bundle-versions -- check --dirty"
        exclusive = true
      }
    }
  }

  ["fix"] {
    fix = true
    stage = true
    steps {
      ["bundle-versions"] {
        check = "mise run checks:agent-bundle-versions -- check --dirty"
        fix = "mise run checks:agent-bundle-versions -- fix --dirty"
        stage = List("mise/conf.d/devtools-agent/bundles/*/.claude-plugin/plugin.json", "mise/conf.d/devtools-agent/bundles/.claude-plugin/marketplace.json")
        exclusive = true
      }
    }
  }
}
