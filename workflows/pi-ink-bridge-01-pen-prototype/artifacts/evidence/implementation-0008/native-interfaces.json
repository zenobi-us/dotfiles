          "text": "    function shareTo(email) {\n        let formatString\n        switch (format) {\n        case ShareEmailDialog.PDF:\n            formatString = \"pdf\";\n            break;\n        case ShareEmailDialog.PNG:\n            formatString = \"png\";\n            break;\n        case ShareEmailDialog.SVG:\n            formatString = \"svg\";\n            break;\n        case ShareEmailDialog.HTML:\n            formatString = \"html\";\n            break;\n        default:\n            console.warn(\"Unrecognised format\", format, \"using pdf instead\");\n            formatString = \"pdf\";\n            break;\n        }\n\n        var options = {\n            \"id\": document.id,\n            \"recipients\": email,\n            \"filename\": filename,\n            \"message\": message,\n            \"format\": formatString,\n            \"pages\": pageSelection.pages,\n            \"password\": password,\n            \"keepPassword\": keepPassword,\n            \"orientation\": root.preferredOrientation,\n        };\n\n        exportTelemetry.reportExportType(formatString);\n        SendMail.enqueue(options);\n    }\n\n    ExportTelemetry {"
