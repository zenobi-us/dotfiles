+#!/usr/bin/env -S mise x -- bun --install=fallback
+// Native command regression coverage; isolated catalogs and assets never touch user sources.
+import assert from "node:assert/strict";
+import { cpSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { spawnSync } from "node:child_process";
+
+const skill = fileURLToPath(new URL("../", import.meta.url));
+const router = fileURLToPath(new URL("../../../../agent-core/skills/skill-contracts/scripts/router.ts", import.meta.url));
+const temp = mkdtempSync(resolve(tmpdir(), "web-design-metadata-"));
+const current = "design-source-metadata/v2";
+const sourceBytes = readFileSync(resolve(skill, "assets/sources.json"), "utf8");
+const baseline = JSON.parse(sourceBytes);
+const historical = sourceBytes.replace(JSON.stringify(current), "1");
+const cli = resolve(skill, "scripts/sources.ts");
+let commands = 0;
+
+function run(argv: string[], expected = 0): string {
+  const result = spawnSync(argv[0], argv.slice(1), { cwd: temp, encoding: "utf8", env: { ...process.env, BUN_OPTIONS: "--install=fallback" } });
+  console.log(JSON.stringify({ argv, cwd: temp, exit_code: result.status, expected_exit_code: expected, stdout: result.stdout, stderr: result.stderr }));
+  assert.equal(result.error, undefined);
+  assert.equal(result.status, expected, result.stderr);
+  commands++;
+  return result.stdout + result.stderr;
+}
+function fixture(name: string, content: string | Buffer): string {
+  const path = resolve(temp, name);
+  writeFileSync(path, content);
+  return path;
+}
+function upgrade(path: string, expected = 0, operation = "upgrade"): string {
+  return run([router, "safe-upgrade", "--skill", skill, "--owner", "file:scripts/source-metadata.ts", "--artifact", path, "--operation", operation], expected);
+}
+function unchanged(path: string, content: string): void {
+  assert.equal(readFileSync(path, "utf8"), content);
+}
+
+try {
+  assert.equal(baseline.schemaVersion, current);
+  run([router, "validate", "--skill", skill]);
+  for (const contract of ["design-source-metadata/v1", current]) run([router, "resolve", "--skill", skill, "--contract", contract]);
+  const old = fixture("historical.json", historical);
+  run([cli, "validate"]);
+  run([cli, "validate", old]);
+  unchanged(old, historical);
+  for (const path of [resolve(skill, "assets/sources.json"), old]) {
+    for (const entry of baseline.sources) {
+      const output = run([cli, "select", entry.style, entry.asset, path]);
+      assert.ok(output.includes(`Style: ${entry.style}\nAsset: ${entry.asset}\n`));
+      assert.ok(output.includes(`Repository: ${entry.source.repository}\nSource path: ${entry.source.path}\n`));
+      assert.ok(output.endsWith(readFileSync(resolve(skill, "assets", entry.asset), "utf8")));
+    }
+  }
+  run([cli, "select", "project-info", "styles/widget-grid-dashboard/DESIGN.md"], 1);
+  const entry = baseline.sources[0];
+  const unicodeRepository = "référence-日本-\uFFFD";
+  const unicode = sourceBytes.replace(JSON.stringify(entry.source.repository), JSON.stringify(unicodeRepository));
+  const unicodePath = fixture("unicode-current.json", Buffer.from(unicode));
+  run([cli, "validate", unicodePath]);
+  const selectedUnicode = run([cli, "select", entry.style, entry.asset, unicodePath]);
+  assert.ok(selectedUnicode.includes(`Repository: ${unicodeRepository}\nSource path: ${entry.source.path}\n`));
+  assert.ok(selectedUnicode.endsWith(readFileSync(resolve(skill, "assets", entry.asset), "utf8")));
+  assert.deepEqual(readFileSync(unicodePath), Buffer.from(unicode));
+  const malformedBytes = Buffer.concat([
+    Buffer.from(historical.slice(0, historical.indexOf(entry.source.repository))),
+    Buffer.from([0xff]),
+    Buffer.from(historical.slice(historical.indexOf(entry.source.repository))),
+  ]);
+  const malformedPath = fixture("invalid-utf8.json", malformedBytes);
+  run([cli, "validate", malformedPath], 1);
+  assert.deepEqual(readFileSync(malformedPath), malformedBytes);
+  run([cli, "select", entry.style, entry.asset, malformedPath], 1);
+  assert.deepEqual(readFileSync(malformedPath), malformedBytes);
+  const authored = historical.replace('"capturedAt":', '"unknown": {"precise": 9007199254740993, "nested": [3, 1, 2]},\n  "capturedAt":');
+  const authoredPath = fixture("authored.json", authored);
+  assert.equal(JSON.parse(upgrade(authoredPath)).changed, true);
+  unchanged(authoredPath, authored.replace('"schemaVersion": 1', `"schemaVersion": ${JSON.stringify(current)}`));
+  const converted = readFileSync(authoredPath, "utf8");
+  assert.equal(JSON.parse(upgrade(authoredPath)).changed, false);
+  unchanged(authoredPath, converted);
+  run([cli, "validate", authoredPath]);
+
+  const invalid = [2, 0, -1, "1", "design-source-metadata/v1", "design-source-metadata/v99", null, {}, []];
+  for (const [index, identity] of invalid.entries()) {
+    const content = JSON.stringify({ ...baseline, schemaVersion: identity });
+    const path = fixture(`unknown-${index}.json`, content);
+    run([cli, "validate", path], 1);
+    upgrade(path, 1);
+    unchanged(path, content);
+  }
+  const absent = { ...baseline };
+  delete absent.schemaVersion;
+  for (const [name, content] of [
+    ["absent", JSON.stringify(absent)],
+    ["mixed", JSON.stringify({ ...baseline, schema: "design-source-metadata/v1" })],
+    ["duplicate", historical.replace('"schemaVersion": 1', '"schemaVersion": 1, "schemaVersion": 1')],
+    ["malformed", "{broken"],
+    ["immutable", JSON.stringify({ ...baseline, schemaVersion: 1, immutable: true })],
+    ["bad-association", JSON.stringify({ ...baseline, schemaVersion: 1, sources: [{ ...baseline.sources[0], style: "project-info" }] })],
+  ]) {
+    const path = fixture(`${name}.json`, content);
+    run([cli, "validate", path], name === "immutable" ? 0 : 1);
+    upgrade(path, 1);
+    unchanged(path, content);
+  }
+  const unsupported = fixture("unsupported.json", historical);
+  upgrade(unsupported, 1, "refresh");
+  unchanged(unsupported, historical);
+  const bulkOld = fixture("bulk-old.json", historical);
+  const bulkImmutableBytes = JSON.stringify({ ...baseline, schemaVersion: 1, immutable: true });
+  const bulkImmutable = fixture("bulk-immutable.json", bulkImmutableBytes);
+  const list = fixture("selected.json", JSON.stringify([bulkOld, bulkImmutable]));
+  const bulk = JSON.parse(run([router, "bulk-upgrade", "--skill", skill, "--owner", "file:scripts/source-metadata.ts", "--artifacts", list], 1));
+  assert.equal(bulk.status, "partial");
+  assert.equal(bulk.results[0].changed, true);
+  unchanged(bulkOld, sourceBytes);
+  unchanged(bulkImmutable, bulkImmutableBytes);
+
+  const isolated = resolve(temp, "isolated-owner");
+  cpSync(skill, isolated, { recursive: true });
+  const asset = resolve(isolated, "assets", baseline.sources[0].asset);
+  const damaged = readFileSync(asset, "utf8") + "\nchanged fixture\n";
+  writeFileSync(asset, damaged);
+  const isolatedCatalog = resolve(isolated, "assets/sources.json");
+  run([resolve(isolated, "scripts/sources.ts"), "select", baseline.sources[0].style, baseline.sources[0].asset], 1);
+  unchanged(asset, damaged);
+  unchanged(isolatedCatalog, sourceBytes);
+  unchanged(resolve(skill, "assets/sources.json"), sourceBytes);
+  for (const entry of baseline.sources) {
+    const bytes = readFileSync(resolve(skill, "assets", entry.asset));
+    assert.equal(new Bun.CryptoHasher("sha256").update(bytes).digest("hex"), entry.sha256);
+  }
+  console.log(`PASS: ${commands} native commands; identity, historical conversion, authored bytes, style/provenance, integrity and partial bulk boundaries.`);
+} finally {
+  rmSync(temp, { recursive: true, force: true });
+}
