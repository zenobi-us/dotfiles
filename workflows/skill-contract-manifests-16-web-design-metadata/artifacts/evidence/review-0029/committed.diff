+#!/usr/bin/env -S mise x -- bun --install=fallback
+// Human-facing catalog validation and selected bundled-source consumption.
+import { catalogPath, readCatalog, selectSource } from "./source-metadata.ts";
+
+const usage = `Usage:
+  sources.ts validate [absolute-catalog.json]
+  sources.ts select <style> <asset-relative-to-assets> [absolute-catalog.json]
+
+The default catalog and all assets resolve from the installed skill, not cwd.
+Selection prints provenance and verified bundled text. Read-only commands never upgrade.
+For explicit conversion, use the shared skill-contracts safe-upgrade or bulk-upgrade
+with --owner file:scripts/source-metadata.ts and this installed skill's --skill path.`;
+
+try {
+  const [command, ...args] = process.argv.slice(2);
+  if (command === "--help") console.log(usage);
+  else if (command === "validate" && args.length <= 1) {
+    const catalog = await readCatalog(args[0] ?? catalogPath);
+    console.log(`Validated catalog identity: ${catalog.schemaVersion}\nCaptured at: ${catalog.capturedAt}`);
+    for (const entry of catalog.sources) console.log(`${entry.style}\t${entry.asset}\t${entry.sha256}`);
+  } else if (command === "select" && (args.length === 2 || args.length === 3)) {
+    const selected = await selectSource(args[0], args[1], args[2] ?? catalogPath);
+    console.log(`Style: ${selected.entry.style}\nAsset: ${selected.entry.asset}\nBundled path: ${selected.path}`);
+    console.log(`Repository: ${selected.entry.source.repository}\nSource path: ${selected.entry.source.path}\nRefresh local path: ${selected.entry.source.localPath}\nSHA-256: ${selected.entry.sha256}\n`);
+    process.stdout.write(selected.text);
+  } else throw new Error(usage);
+} catch (error) {
+  console.error(error instanceof Error ? error.message : "Metadata operation failed.");
+  process.exitCode = 1;
+}
