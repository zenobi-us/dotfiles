+/**
+ * The surf driver: a real, visible Chrome through the surf extension.
+ *
+ * A surf workflow cannot build evidence records the way a playwright script
+ * does. It returns only a status per workflow step and the values its `as`
+ * steps captured. So `compile` writes two files per test: the workflow, and a
+ * step map that says which workflow steps belong to which plan step. `runTest`
+ * rebuilds the records from the map and the `--json` output, and captures
+ * `location.href` after every navigate and click so each record carries the
+ * page it was taken on.
+ *
+ * Surf has no working assertion keyword (`expect`, `when`, `retry` and
+ * friends are accepted and ignored), so every assertion is a `js` step that
+ * throws. Each one polls, because a list that refetches after an action is
+ * not wrong for being a moment late.
+ *
+ * The traps behind these choices are in references/drivers/surf-cli.md.
+ */
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import type { Evidence, Plan, Precondition, Step, Test } from "../plan.ts";
+import { approvedUrl, safetyCode, shotPath, stepNumber } from "../plan.ts";
+import { CliError, sh } from "../sh.ts";
+import type { DriverRun } from "../verdict.ts";
+import type { Driver, RunContext } from "./driver.ts";
+
+const q = (s: string) => JSON.stringify(s);
+const DEFAULT_EXPECT_MS = 5000;
+const POLL_MS = 200;
+
+/** Which workflow steps (by index) one plan step compiled to. */
+export type StepMapEntry = {
+ step: string;
+ kind: Step["do"];
+ target: string;
+ /** Index of the first workflow step, 0-based. */
+ from: number;
+ count: number;
+ shot: string;
+ /** The `vars` key holding this step's resolved value, if any. */
+ value?: string;
+ /** The `vars` key holding `location.href` after this step, if any. */
+ url?: string;
+ /** For an `expect`: which kind of check, so the caption matches the playwright driver. */
+ check?: "url" | "absent" | "text" | "present";
+ needs?: string;
+ captures?: Array<{ shot: string; metadata: string; index: number; sequence: number }>;
+ assertionIndex?: number;
+ dialog?: string;
+};
+
+export type SurfRunJson = {
+ status: string;
+ completedSteps?: number;
+ totalSteps?: number;
+ results: Array<{ step: number; cmd: string; status: string; error?: string }>;
+ error?: string;
+ vars?: Record<string, unknown>;
+};
+
+type WorkflowStep = { tool: string; args: Record<string, unknown>; as?: string };
+
+// Surf substitutions accept word characters only. Hex preserves punctuation without collisions.
+const varKey = (prefix: string, step: string) => `${prefix}_${Buffer.from(step).toString("hex")}`;
+
+/** `ASSERT FAIL <step>: <detail>` as a JS string literal, safe for any locator. */
+const fail = (step: string, detail: string) => q(`ASSERT FAIL ${step}: ${detail}`);
+
+/**
+ * A js step that retries `body` until it returns or `ms` runs out. `body` is a
+ * function body that throws on failure and returns the value to keep.
+ */
+function poll(body: string, ms: number): string {
+ return `new Promise(function(res,rej){var t0=Date.now();(function tick(){` +
+  `try{res((function(){${body}})());}catch(e){if(Date.now()-t0>${ms})rej(e);else setTimeout(tick,${POLL_MS});}` +
+  `})();})`;
+}
+
+const once = (body: string) => `(function(){${body}})()`;
+const find = (locator: string, step: string) =>
+ `var e=document.querySelector(${q(locator)});if(!e)throw new Error(${fail(step, `${locator} not found`)});`;
+
+function expectBody(s: Extract<Step, { do: "expect" }>, step: string): string {
+ if (s.url) {
+  return `var u=location.href;if(!new RegExp(${q(s.url)}).test(u))throw new Error(${fail(step, `expected URL to match ${s.url}, got `)}+u);return u;`;
+ }
+ if (s.visible === false) {
+  return `if(document.querySelector(${q(s.locator!)}))throw new Error(${fail(step, `${s.locator} was present and should not be`)});return 'absent';`;
+ }
+ if (s.text) {
+  return `${find(s.locator!, step)}var t=e.innerText.trim();if(t.indexOf(${q(s.text)})<0)throw new Error(${fail(step, `expected ${s.text}, got `)}+t);return t;`;
+ }
+ return `${find(s.locator!, step)}return e.outerHTML.slice(0,120);`;
+}
+
+export function compileSurf(plan: Plan, t: Test, shotsDir: string): { workflow: string; map: StepMapEntry[] } {
+ void shotsDir;
+ const steps: WorkflowStep[] = [];
+ const map: StepMapEntry[] = [];
+ if (!plan.approval?.origins.length) throw new Error("An explicit origin approval is required");
+ let needsHuman = false;
+
+ t.steps.forEach((s, i) => {
+  if (needsHuman) return;
+  const step = stepNumber(t.id, i);
+  const shot = s.shot ? shotPath(t.id, i, s.shot) : "";
+  const from = steps.length;
+  const entry: StepMapEntry = { step, kind: s.do, target: "", from, count: 0, shot };
+  let sequence = 0;
+  const snap = () => {
+   if (!s.shot) return;
+   const number = ++sequence;
+   const path = shotPath(t.id, i, s.shot, number);
+   const metadata = varKey(`capture_${number}`, step);
+   (entry.captures ??= []).push({ shot: path, metadata, index: steps.length, sequence: number });
+   entry.shot = path;
+   steps.push({ tool: "screenshot", args: { output: `%{shots}/${path.replace(/^shots\//, "")}` } });
+   steps.push({ tool: "js", args: { code: `JSON.stringify({capturedAt:new Date().toISOString(),url:location.href,viewport:{width:innerWidth,height:innerHeight,deviceScaleFactor:devicePixelRatio}})` }, as: metadata });
+  };
+  const captureUrl = () => {
+   entry.url = varKey("url", step);
+   steps.push({ tool: "js", args: { code: "location.href" }, as: entry.url });
+  };
+  entry.dialog = varKey("dialog", step);
+  steps.push({ tool: "dialog.info", args: {}, as: entry.dialog });
+  const nativeGuard = `var d=%{${entry.dialog}};if(d.hasDialog||(d.result&&d.result.hasDialog))throw new Error(${q(`SAFETY STOP ${step}: native dialog; human handling required`)});`;
+  steps.push({ tool: "js", args: { code: once(`${nativeGuard}return ${safetyCode(plan, step, s.do === "click" || (s.do === "press" && (/(?:^|[+ ])(?:Enter|Space|Spacebar)$/i.test(s.key) || s.key === " ")), s.do === "navigate" ? s.to : undefined)};`) } });
+
+  switch (s.do) {
+   case "navigate":
+    entry.target = s.to;
+    steps.push({ tool: "navigate", args: { url: approvedUrl(plan, s.to) } });
+    steps.push({ tool: "wait.load", args: {} });
+    captureUrl();
+    steps.push({ tool: "js", args: { code: safetyCode(plan, step) } });
+    snap();
+    break;
+   case "click":
+    entry.target = s.locator;
+    if (s.dom) {
+     steps.push({ tool: "js", args: { code: once(`${find(s.locator, step)}e.click();return 'clicked';`) } });
+    } else {
+     steps.push({ tool: "click", args: { selector: s.locator } });
+    }
+    steps.push({ tool: "wait.load", args: {} });
+    steps.push({ tool: "js", args: { code: safetyCode(plan, step) } });
+    captureUrl();
+    snap();
+    break;
+   case "fill":
+    entry.target = s.locator;
+    steps.push({ tool: "js", args: { code: once(`${find(s.locator, step)}if(e.type==='password'||/username|password|one-time-code/.test(e.autocomplete||''))throw new Error('SAFETY STOP ${step}: credential input');return 'safe';`) } });
+    steps.push({ tool: "type", args: { text: s.text, into: s.locator, clear: true } });
+    snap();
+    break;
+   case "capture": {
+    entry.target = s.locator;
+    entry.value = s.as;
+    const read = s.attr ? `e.getAttribute(${q(s.attr)})` : `e.innerText.trim()`;
+    steps.push({ tool: "js", args: { code: once(`${find(s.locator, step)}return ${read};`) }, as: s.as });
+    snap();
+    break;
+   }
+   case "expect":
+    entry.target = s.locator ?? `url ~ ${s.url}`;
+    entry.value = varKey("assert", step);
+    entry.check = s.url ? "url" : s.visible === false ? "absent" : s.text ? "text" : "present";
+    // A throw halts the workflow, so shoot first to keep an image of a
+    // failure, then shoot again to show the settled page on a pass.
+    snap();
+    entry.assertionIndex = steps.length;
+    steps.push({ tool: "js", args: { code: poll(expectBody(s, step), s.timeoutMs ?? DEFAULT_EXPECT_MS) }, as: entry.value });
+    snap();
+    break;
+   case "wait":
+    entry.target = s.gone ? `gone ${s.locator}` : s.locator;
+    if (s.gone) {
+     entry.value = varKey("wait", step);
+     steps.push({
+      tool: "js",
+      args: {
+       code: poll(
+        `if(document.querySelector(${q(s.locator)}))throw new Error(${fail(step, `${s.locator} still present`)});return 'gone';`,
+        s.timeoutMs ?? 30000,
+       ),
+      },
+      as: entry.value,
+     });
+    } else {
+     steps.push({ tool: "wait.element", args: { selector: s.locator, timeout: s.timeoutMs ?? 30000 } });
+    }
+    snap();
+    break;
+   case "scroll":
+    entry.target = s.locator;
+    entry.value = varKey("scroll", step);
+    steps.push({
+     tool: "js",
+     args: { code: once(`${find(s.locator, step)}e.scrollIntoView({block:'center'});return e.outerHTML.slice(0,120);`) },
+     as: entry.value,
+    });
+    snap();
+    break;
+   case "press":
+    entry.target = s.key;
+    steps.push({ tool: "key", args: { key: s.key } });
+    snap();
+    break;
+   case "human":
+    entry.target = "human step";
+    entry.needs = s.needs;
+    needsHuman = true;
+    snap();
+    break;
+  }
+  entry.count = steps.length - from;
+  map.push(entry);
+ });
+
+ const workflow = JSON.stringify(
+  {
+   name: `${plan.workId}-test-${t.id}`,
+   description: `Test ${t.id} - ${t.claim}`,
+   args: {
+    base: { required: true, desc: "App base URL" },
+    shots: { required: true, desc: "Absolute directory for evidence screenshots" },
+   },
+   steps,
+  },
+  null,
+  2,
+ );
+ return { workflow, map };
+}
+
+/** The JSON object in surf's output, which may be preceded by a session banner. */
+export function parseSurfJson(output: string): SurfRunJson | null {
+ const at = output.indexOf("{");
+ if (at < 0) return null;
+ try {
+  const run = JSON.parse(output.slice(at)) as SurfRunJson;
+  return Array.isArray(run.results) && typeof run.status === "string" ? run : null;
+ } catch {
+  return null;
+ }
+}
+
+
+/** The same captions the playwright driver writes, so a report reads alike for both. */
+const EXPECT_OBSERVED: Record<NonNullable<StepMapEntry["check"]>, (value: string) => string> = {
+ url: (v) => `URL matched: ${v}`,
+ absent: () => "Absent, as required.",
+ text: (v) => `Found text: ${v}`,
+ present: () => "Present, as required.",
+};
+
+const OBSERVED: Partial<Record<Step["do"], string>> = {
+ navigate: "Page loaded.",
+ click: "Clicked.",
+ fill: "Typed.",
+ wait: "Rendered.",
+ scroll: "Scrolled into view.",
+};
+
+/**
+ * Plan-ordered evidence records from one surf run. Pure: everything comes from
+ * the step map, the run's `--json` and the files on disk.
+ */
+export function recordsFromSurfRun(
+ plan: Plan,
+ t: Test,
+ map: StepMapEntry[],
+ run: SurfRunJson,
+): Pick<DriverRun, "records" | "failure"> {
+ const vars = run.vars ?? {};
+ const records: Evidence[] = [];
+ let url = "";
+
+ for (const entry of map) {
+  const native = entry.dialog ? dialogOpen(vars[entry.dialog]) : false;
+  if (native) return { records, failure: { step: entry.step, message: `SAFETY STOP ${entry.step}: native dialog; human handling required`, blocked: true } };
+  const results = run.results.slice(entry.from, entry.from + entry.count);
+  const failed = results.find((r) => r.status !== "ok");
+  const captureFailed = failed?.cmd === "screenshot";
+  const complete = results.length === entry.count && !failed;
+  if (!complete && !failed) {
+   // Every earlier failure has already returned, so the run stopped here.
+   if (run.status !== "completed") {
+    const message = run.error ?? "The run stopped without a message.";
+    return { records, failure: { step: entry.step, message, blocked: message.includes("SAFETY STOP") } };
+   }
+   break;
+  }
+
+  if (entry.kind === "navigate") {
+   const to = entry.target;
+   url = to.startsWith("http") ? to : `${plan.base}${to}`;
+  }
+  if (entry.url && typeof vars[entry.url] === "string") url = vars[entry.url] as string;
+  const value = entry.value !== undefined ? vars[entry.value] : undefined;
+  const resolved = value === undefined || value === null ? "" : String(value);
+  const captures = (entry.captures ?? []).filter((capture) =>
+   run.results[capture.index]?.status === "ok");
+  const captureRecords = captures.map((capture) => {
+   let metadata: Partial<Evidence> = {};
+   const raw = vars[capture.metadata];
+   try { metadata = typeof raw === "string" ? JSON.parse(raw) : (raw as Partial<Evidence>) ?? {}; } catch { }
+   return { screenshot: capture.shot, capturedAt: metadata.capturedAt, viewport: metadata.viewport, captureSequence: capture.sequence, url: metadata.url ?? url };
+  });
+
+  const record: Evidence = {
+   test: t.id,
+   step: entry.step,
+   action: captureFailed && !(entry.assertionIndex !== undefined && run.results[entry.assertionIndex]?.status === "ok") ? "capture" : entry.kind === "expect" ? "assert" : entry.kind === "fill" ? "type" : entry.kind === "capture" ? "read" : entry.kind === "human" ? "assert" : entry.kind,
+   target: entry.target,
+   resolved,
+   ...(captureFailed ? { url, screenshot: "", captureStatus: "failed" as const } : captureRecords.at(-1) ?? { url, screenshot: "" }),
+   assertionPassed: entry.kind === "expect" && entry.assertionIndex !== undefined && run.results[entry.assertionIndex]?.status === "ok",
+   observed: failed
+    ? String(failed.error ?? run.error ?? "The step failed without a message.")
+    : entry.kind === "expect"
+     ? EXPECT_OBSERVED[entry.check ?? "present"](resolved)
+     : entry.kind === "capture"
+      ? `Read: ${resolved}`
+      : entry.kind === "press"
+       ? `Pressed ${entry.target}.`
+       : entry.kind === "wait" && resolved === "gone"
+        ? "Gone."
+        : entry.kind === "human"
+         ? "Driver cannot complete this step."
+         : OBSERVED[entry.kind] ?? "Done.",
+   verdict: entry.kind === "human" ? "PARTIAL" : "",
+   note: entry.kind === "human" ? (entry.needs ?? "") : "",
+  };
+  for (const capture of captureFailed ? captureRecords : captureRecords.slice(0, -1)) {
+   records.push({ ...record, ...capture, captureStatus: "captured", action: "capture", assertionPassed: undefined, observed: "Captured before expect.", verdict: "", note: "" });
+  }
+  records.push(record);
+
+  if (failed) {
+   return { records, failure: { step: entry.step, message: record.observed, blocked: record.observed.includes("SAFETY STOP"), captureFailed, assertionPassed: record.assertionPassed } };
+  }
+ }
+
+ if (run.status !== "completed") {
+  const message = run.error ?? "The run stopped without a message.";
+  return { records, failure: { step: records.at(-1)?.step ?? `${t.id}.1`, message, blocked: message.includes("SAFETY STOP") } };
+ }
+ return { records };
+}
+
+function dialogOpen(value: unknown): boolean {
+ if (typeof value === "string") { try { return dialogOpen(JSON.parse(value)); } catch { return false; } }
+ if (!value || typeof value !== "object") return false;
+ const info = value as { hasDialog?: boolean; result?: unknown };
+ return info.hasDialog === true || (info.result !== undefined && dialogOpen(info.result));
+}
+
+const surfEnv = (session: string) => ({ SURF_SESSION: session });
+const ownedSessions = new Set<string>();
+async function checked(cmd: string[], session: string): Promise<string> {
+ const result = await sh(cmd, surfEnv(session));
+ if (result.code !== 0) throw new Error(`${cmd[1]} failed: ${result.err || result.out}`);
+ return result.out;
+}
+
+export const surfDriver: Driver = {
+ name: "surf",
+ attended: true,
+
+ scriptName: (plan, testId) => `${plan.workId}-test-${testId}.json`,
+
+ compile(plan, test, shotsDir) {
+  const { workflow, map } = compileSurf(plan, test, shotsDir);
+  const name = this.scriptName(plan, test.id);
+  return { [name]: workflow, [`${name}.map`]: JSON.stringify({ schema: "collect-evidence/v1", kind: "driver-map", entries: map }, null, 2) };
+ },
+
+ // surf session names allow letters, digits, dot, underscore and hyphen, up to 64.
+ sessionName: (plan) => plan.workId.replace(/[^A-Za-z0-9._-]/g, "-").slice(0, 64),
+
+ async open(session) {
+  const listed = await checked(["surf", "session.list", "--json"], session);
+  let sessions: unknown;
+  try { sessions = JSON.parse(listed.slice(listed.indexOf("{") >= 0 && !listed.trim().startsWith("[") ? listed.indexOf("{") : 0)); }
+  catch { throw new Error("Cannot inspect Surf session ownership"); }
+  const contains = (value: unknown): boolean => {
+   if (typeof value === "string") return value === session;
+   if (Array.isArray(value)) return value.some(contains);
+   return value !== null && typeof value === "object" && (Object.hasOwn(value, session) || Object.values(value).some(contains));
+  };
+  if (contains(sessions)) throw new CliError(`Refusing existing Surf session: ${session}`, 3);
+  const output = await checked(["surf", "session.new", session, "about:blank"], session);
+  ownedSessions.add(session);
+  try {
+   const tab = output.match(/tab=(\d+)/)?.[1];
+   if (!tab) throw new Error(`surf session.new ${session} printed no tab id`);
+   await checked(["surf", "tab.switch", tab], session);
+  } catch (error) { await this.close(session); throw error; }
+ },
+
+ async checkPrecondition(plan: Plan, p: Precondition, session: string) {
+  if (!ownedSessions.has(session)) return { ok: false, detail: `Surf session is not owned: ${session}` };
+  if (!p.check.locator) return { ok: true, detail: `${p.desc} (declared, not machine-checked)` };
+  try {
+   await checked(["surf", "js", safetyCode(plan, `precondition:${p.id}`)], session);
+   if (p.check.goto) {
+    await checked(["surf", "navigate", "about:blank"], session);
+    await checked(["surf", "navigate", approvedUrl(plan, p.check.goto)], session);
+    await checked(["surf", "js", safetyCode(plan, `precondition:${p.id}`)], session);
+   }
+   const body = `var e=document.querySelector(${q(p.check.locator)});if(!e)throw new Error('absent');` +
+    `var t=e.innerText.trim();` +
+    (p.check.text ? `if(t.indexOf(${q(p.check.text)})<0)throw new Error('text missing');` : "") +
+    `return JSON.stringify({ok:true,got:t.slice(0,200)});`;
+   const r = await sh(["surf", "js", poll(body, p.check.timeoutMs ?? DEFAULT_EXPECT_MS)], surfEnv(session));
+   if (r.code !== 0) return { ok: false, detail: `${p.desc} — driver check failed` };
+   const line = (r.out.trim().split("\n").pop() ?? "").trim();
+   try {
+    let v: unknown = JSON.parse(line);
+    if (typeof v === "string") v = JSON.parse(v);
+    const got = (v as { got?: string }).got ?? "";
+    return { ok: Boolean((v as { ok?: boolean }).ok), detail: `${p.desc} — found ${JSON.stringify(got).slice(0, 200)}` };
+   } catch {
+    const reason = (r.out + r.err).match(/Error: ([^\n]+)/)?.[1] ?? "no output";
+    return { ok: false, detail: `${p.desc} — not met (${reason.slice(0, 160)})` };
+   }
+  } catch (error) {
+   return { ok: false, detail: error instanceof Error ? error.message : String(error) };
+  }
+ },
+
+ async runTest(ctx: RunContext): Promise<DriverRun> {
+  if (!ownedSessions.has(ctx.session)) return { records: [], failure: { step: `${ctx.test.id}.1`, message: `Surf session is not owned: ${ctx.session}`, blocked: true }, raw: "", attempts: 0 };
+  const name = this.scriptName(ctx.plan, ctx.test.id);
+  const workflow = join(ctx.workflowDir, name);
+  const envelope = JSON.parse(await readFile(`${workflow}.map`, "utf8")) as { schema: string; kind: string; entries: StepMapEntry[] };
+  if (envelope.schema !== "collect-evidence/v1" || envelope.kind !== "driver-map" || !Array.isArray(envelope.entries)) throw new Error("Unsupported Surf driver map schema");
+  const map = envelope.entries;
+  const shots = join(ctx.reportDir, "shots");
+
+  // No automatic retry: a second run could repeat a side effect.
+  try {
+   const native = await checked(["surf", "dialog.info", "--json"], ctx.session);
+   if (dialogOpen(JSON.parse(native.slice(native.indexOf("{"))))) throw new CliError(`SAFETY STOP ${ctx.test.id}.1: native dialog; human handling required`, 3);
+   await checked(["surf", "js", safetyCode(ctx.plan, `${ctx.test.id}.1`)], ctx.session);
+   await checked(["surf", "navigate", "about:blank"], ctx.session);
+  } catch (error) {
+   const message = error instanceof Error ? error.message : String(error);
+   return { records: [], failure: { step: `${ctx.test.id}.1`, message, blocked: message.includes("SAFETY STOP") }, raw: message, attempts: 0 };
+  }
+  const r = await sh(
+   ["surf", "do", workflow, "--base", ctx.plan.base, "--shots", shots, "--json"],
+   surfEnv(ctx.session),
+  );
+  const raw = r.out + r.err;
+  const json = parseSurfJson(r.out);
+  const attempts = 1;
+  let nativeBlocked = false;
+  try {
+   const native = await checked(["surf", "dialog.info", "--json"], ctx.session);
+   nativeBlocked = dialogOpen(JSON.parse(native.slice(native.indexOf("{"))));
+  } catch (error) {
+   const message = `SAFETY STOP: cannot inspect the current dialog state: ${error instanceof Error ? error.message : String(error)}`;
+   return { records: json ? recordsFromSurfRun(ctx.plan, ctx.test, map, json).records : [], failure: { step: `${ctx.test.id}.1`, message, blocked: true }, raw, attempts };
+  }
+
+  if (!json) {
+   return {
+    records: [],
+    failure: { step: `${ctx.test.id}.1`, message: nativeBlocked ? "SAFETY STOP: native dialog; human handling required" : `surf printed no JSON: ${raw.trim().split("\n").slice(-1)[0] ?? ""}`, blocked: nativeBlocked },
+    raw,
+    attempts,
+   };
+  }
+  const result = recordsFromSurfRun(ctx.plan, ctx.test, map, json);
+  if (r.code !== 0 && !result.failure) result.failure = { step: result.records.at(-1)?.step ?? `${ctx.test.id}.1`, message: r.err || "Surf exited unsuccessfully" };
+  if (nativeBlocked) result.failure = { step: result.failure?.step ?? result.records.at(-1)?.step ?? `${ctx.test.id}.1`, message: "SAFETY STOP: native dialog; human handling required", blocked: true };
+  return { ...result, raw, attempts };
+ },
+
+ async close(session) {
+  if (!ownedSessions.has(session)) return;
+  await checked(["surf", "session.close", session], session);
+  ownedSessions.delete(session);
+ },
+
+ cleanupRow: (session) => ({
+  item: `surf session <code class="code">${session}</code>`,
+  state: "A window in the developer's own Chrome, closed at the end of the run",
+  action: `<strong>Nothing to undo.</strong> Confirm with <code class="code">surf session.list</code>.`,
+ }),
+};
