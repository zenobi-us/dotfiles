+    await cp(join(dir, "plan.ts"), join(staging, "plan.ts"));
+    await mkdir(join(staging, "report", "shots"), { recursive: true });
+    await mkdir(join(staging, "runs"));
+    if (plan.video) await mkdir(join(staging, "report", "videos"));
