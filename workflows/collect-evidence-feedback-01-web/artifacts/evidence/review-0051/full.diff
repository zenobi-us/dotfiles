-  value?: string;
-  /** The `vars` key holding `location.href` after this step, if any. */
-  url?: string;
-  /** For an `expect`: which kind of check, so the caption matches the playwright driver. */
-  check?: "url" | "absent" | "text" | "present";
-  needs?: string;
-};
