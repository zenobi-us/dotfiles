{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "cli-workspace-chrome"
          },
          "size": {
            "px": 32
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "cli-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "cli-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "cli-workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 75
          }
        }
      ],
      "size": {
        "px": 220
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "cli-tabs"
          },
          "size": {
            "px": 32
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "cli-pane"
                    },
                    "reveal": "hover",
                    "height": 22,
                    "position": "top"
                  },
                  "background": "background",
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 0,
                  "gap": 0
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "cli-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "cli-changes"
                      }
                    },
                    {
                      "id": "context",
                      "type": "block",
                      "content": {
                        "mod": "shared-context",
                        "props": {
                          "mode": "context"
                        }
                      }
                    },
                    {
                      "id": "tracker",
                      "type": "block",
                      "content": {
                        "mod": "shared-context",
                        "props": {
                          "mode": "tracker"
                        }
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "hidden": true
            }
          ],
          "padding": 0,
          "gap": 0
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          },
          "hidden": true
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": "cli",
  "font": "Roboto Mono",
  "font_size": 16,
  "ui_font": "Roboto Mono",
  "terminal_padding": [
    2,
    8
  ],
  "divider": {
    "width": 1,
    "color": "#1f2530"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/cli.svg"
}
