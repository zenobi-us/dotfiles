{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "muxer-completion/v2"
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "starting",
        "running",
        "blocked",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "source": {
      "enum": [
        "launcher",
        "agent",
        "process"
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT",
      "minLength": 20
    },
    "exitCode": {
      "type": "integer"
    },
    "detail": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "sequence",
    "state",
    "source",
    "timestamp"
  ],
  "description": "Current output. Run identity, process completion, resource shutdown and domain success remain independent. Completion sequence files and owned process records are immutable; summaries are projections."
}
