{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "muxer-owned-process/v2"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "bootId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "startTicks": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "command": {
      "type": "string"
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "running",
        "stopped",
        "unconfirmed"
      ]
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "parentPid": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schemaVersion",
    "pid",
    "bootId",
    "startTicks",
    "command",
    "state",
    "runId"
  ],
  "description": "Current output. Run identity, process completion, resource shutdown and domain success remain independent. Completion sequence files and owned process records are immutable; summaries are projections."
}
