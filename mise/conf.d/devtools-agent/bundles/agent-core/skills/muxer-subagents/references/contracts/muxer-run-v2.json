{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "muxer-run/v2"
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "muxer": {
      "enum": [
        "herdr",
        "herdr-app",
        "tmux",
        "zellij"
      ]
    },
    "agent": {
      "enum": [
        "omp",
        "pi",
        "zot",
        "claude",
        "codex"
      ]
    },
    "target": {
      "type": "string"
    },
    "agentName": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "parentRunId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT",
      "minLength": 20
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "muxer",
    "agent",
    "target",
    "createdAt"
  ],
  "description": "Current output. Run identity, process completion, resource shutdown and domain success remain independent. Completion sequence files and owned process records are immutable; summaries are projections."
}
