    "shared-context-layout/v1": "file:references/contracts.md",
    "shared-context-layout/v2": "file:references/contracts.md",
    "shared-context-config/v1": "file:references/contracts.md",
    "shared-context-project/v1": "file:references/contracts.md",
    "shared-context-source/v1": "file:references/contracts.md",
    "shared-context-index/v1": "file:references/contracts.md",
    "shared-context-resolution/v1": "file:references/contracts.md"
