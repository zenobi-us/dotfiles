  "upgrades": [
    {"from": "shared-context-routes/v2", "to": "shared-context-routes/v3", "procedure": "file:references/configuration-upgrades.md"},
    {"from": "shared-context-layout/v1", "to": "shared-context-layout/v2", "procedure": "file:references/configuration-upgrades.md"}
  ]
}
