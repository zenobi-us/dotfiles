  "accepts": ["shared-context-routes/v2", "shared-context-routes/v3", "shared-context-layout/v1", "shared-context-layout/v2", "shared-context-config/v1", "shared-context-project/v1", "shared-context-source/v1", "shared-context-index/v1"],
  "contracts": {
    "shared-context-routes/v2": "file:references/contracts.md",
