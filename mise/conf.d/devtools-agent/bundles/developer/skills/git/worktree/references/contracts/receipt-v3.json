{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worktree-receipt/v3",
  "title": "worktree-receipt/v3",
  "type": "object",
  "required": [
    "schemaVersion",
    "receipt_id",
    "workflow_id",
    "phase",
    "event",
    "status",
    "attempt",
    "parent_receipt",
    "repository",
    "worktree",
    "workspace_path",
    "source_branch",
    "base_branch",
    "source_commit",
    "source_tree",
    "created_at",
    "muxer",
    "agent",
    "pane_id",
    "session_id",
    "ticket",
    "ticket_ref",
    "workflow",
    "inputs",
    "outputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "worktree-receipt/v3"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "ticket": {
      "type": "object",
      "required": [
        "backend",
        "id",
        "ref"
      ]
    },
    "workflow": {
      "type": "object",
      "required": [
        "store",
        "root",
        "ref"
      ]
    },
    "inputs": {
      "type": "array"
    },
    "outputs": {
      "type": "array"
    }
  },
  "not": {
    "required": [
      "schema"
    ]
  },
  "additionalProperties": true,
  "x-owner-validator": "scripts/receipt-validation.ts",
  "x-compatibility": "Immutable. V2 introduced canonical phases, exact result reconciliation and reviewed-source/integration separation. V3 retains those semantics and changes only the identifier field. Use receipt-validation.ts, receipt-contract.ts and receipt-diagnostics.ts together. Do not upgrade events; mixed-version parent chains are supported."
}
