#!/usr/bin/env -S mise x -- bun --install=fallback

import { closeSync, constants, createReadStream, fstatSync, fsyncSync, linkSync, lstatSync, mkdirSync, openSync, readFileSync, readSync, readdirSync, realpathSync, rmdirSync, unlinkSync, utimesSync, writeFileSync, writeSync, type Stats } from "node:fs";
import { basename, dirname, extname, isAbsolute, join, relative, resolve, sep } from "node:path";
import { parseArgs } from "node:util";
import { createInterface } from "node:readline/promises";
import { BoxRenderable, TextRenderable, InputRenderable, ScrollBoxRenderable, StyledText, fg, createCliRenderer } from "@opentui/core@0.6.6";
import { Context, Liquid, LiquidError, UndefinedVariableError, type Template } from "liquidjs@10.30.0";

type Json = Record<string, unknown>;
type Fingerprint = { size: number; mtimeMs: number; dev: number; ino: number };
type Companion = { path: string; suffix: string; fingerprint: Fingerprint };
type RecoveryField = "basemodel" | "topic" | "model.name" | "model.version" | "model.creator";
type Proposal = { field: RecoveryField; value: string; source: string; evidence: "recorded" | "retrieved" | "heuristic" | "manual"; status: "pending" | "accepted" | "rejected" };
type Recovery = { state: "idle" | "queued" | "hashing" | "fetching" | "suggested" | "no-data" | "not-found" | "error" | "cancelled"; message: string };
type TreeTone = "normal" | "error" | "warning" | "suggested" | "accepted" | "muted";
type Rules = { tagTopics: Record<string, string>; basemodelAliases: Record<string, string>; overrides: Record<string, { basemodel?: string; topic?: string }>; ignored: string[]; accepted: Record<string, Proposal[]> };
type BlockerCategory = "missing-data" | "corrupted-data" | "unreadable-data" | "duplicate-destination" | "conflicting-data" | "ambiguous-companion" | "unsafe-path" | "invalid-template";
type Blocker = { category: BlockerCategory; message: string };
class PlanningError extends Error {
  constructor(readonly category: BlockerCategory, message: string) { super(message); }
}
type Model = {
  source: string; stem: string; file: string; ext: string; companions: Companion[];
  raw: { metadata: Json | null; cmInfo: Json | null; header: Json | null };
  errors: Blocker[]; context: Json; provenance: Json; conflicts: Blocker[];
  proposals: Proposal[]; recoveryNotes: string[]; recovery: Recovery;
};
type Move = { source: string; destination: string; fingerprint: Fingerprint };
type Patch = { source: string; destination: string; changes: { field: string; before: string; after: string }[] };
type Entry = { source: string; destination: string | null; status: "MOVE" | "UNCHANGED" | "BLOCKED" | "IGNORED"; fields: Json; provenance: Json; blockers: Blocker[]; proposals: Proposal[]; recoveryNotes: string[]; recovery: Recovery; warnings: string[]; moves: Move[]; patches: Patch[] };
type Plan = { version: number; readOnly: true; root: string; template: string; createdAt: string; rules: Rules; warnings: string[]; summary: Record<Entry["status"], number>; entries: Entry[] };
type Row = { key: string; name: string; model?: Model; directory?: boolean; depth: number; parent?: string; tone?: TreeTone; badge?: string; badgeTone?: TreeTone };

const DEFAULT_TEMPLATE = "{{ basemodel | slug }}/{{ topic | slug }}/{{ file }}";

async function main() {
  if (process.argv.includes("--help") || process.argv.includes("-h")) { console.log(HELP); return; }
  const { values, positionals } = parseArgs({ args: process.argv.slice(2), allowPositionals: true, options: {
    view: { type: "string", default: "explorer" }, template: { type: "string", default: DEFAULT_TEMPLATE },
    plan: { type: "boolean" }, json: { type: "boolean" }, plain: { type: "boolean" }, fields: { type: "boolean" },
    output: { type: "string", short: "o" }, rules: { type: "string" }, headers: { type: "boolean" },
    propose: { type: "boolean" }, retrieve: { type: "string" },
    "auto-propose": { type: "boolean" }, "propose-blocked": { type: "boolean" },
    "accept-suggestions": { type: "boolean" },
    apply: { type: "string" }, receipt: { type: "string" }, "dry-run": { type: "boolean" }, yes: { type: "boolean", short: "y" },
    "no-input": { type: "boolean" }, "no-color": { type: "boolean" }, version: { type: "boolean" },
  } });
  if (values.version) { console.log("lora-organise 3.0.0"); return; }
  if (values.apply) {
    if (positionals.length || values.plan || values.output || values.rules || values.fields || values.plain || values.propose || values.retrieve || values["auto-propose"] || values["propose-blocked"] || values["accept-suggestions"] || values.headers || values.view !== "explorer" || values.template !== DEFAULT_TEMPLATE) throw new Error("--apply uses the saved plan and its root. Do not combine it with scanning or proposal options.");
    await applySavedPlan(values.apply, values.receipt, !!values["dry-run"], !!values.yes, !!values["no-input"]);
    return;
  }
  if (values.receipt || values["dry-run"] || values.yes) throw new Error("--receipt, --dry-run, and --yes require --apply PLAN.json.");
  if (positionals.length > 1) throw new Error("Use one model root. See --help.");
  if (!["explorer", "plan"].includes(values.view!)) throw new Error("--view must be explorer or plan.");
  if ([values.propose, values["auto-propose"], values["propose-blocked"]].filter(Boolean).length > 1) throw new Error("Choose one proposal mode: --propose, --auto-propose, or --propose-blocked.");
  const root = realpathSync(resolve(positionals[0] ?? "."));
  if (!lstatSync(root).isDirectory()) throw new Error("The model root must be a directory.");
  const rules = loadRules(values.rules);
  const interactive = !values.propose && !values.retrieve && !values.plan && !values.json && !values.plain && !values.fields && !values.output && !values["no-input"] && process.stdin.isTTY && process.stdout.isTTY && process.env.TERM !== "dumb";
  if (interactive) process.stderr.write("Indexing LoRA metadata (model tensors are not loaded)…\n");
  const { models, occupied, warnings } = scan(root, !!values.headers);
  for (const model of models) classify(model, rules);
  const autoScope = values["auto-propose"] ? "all" : values["propose-blocked"] ? "blocked" : null;
  if (values.propose) await proposeLocalBatch(root, models, rules);
  if (values.retrieve) {
    const model = models.find(item => item.source === relative(root, resolve(root, values.retrieve!)));
    if (!model) throw new Error("--retrieve must name a model inside the root.");
    proposeLocal(root, model, rules);
    await retrieveMetadata(root, model, rules);
  }
  const fields = discoverFields(models);
  compileTemplate(values.template!);
  let plan = buildPlan(root, models, occupied, warnings, rules, values.template!);
  if (values.fields) { console.log(JSON.stringify(fields, null, 2)); return; }
  if (interactive) {
    await showUI(root, models, occupied, warnings, rules, values.template!, values.view === "plan", !!values["no-color"], autoScope, !!values["accept-suggestions"], !!values.headers);
    return;
  }
  if (autoScope) await suggestCollection(root, models, rules, autoScope === "blocked" ? blockedSources(plan) : undefined);
  if (values["accept-suggestions"]) { acceptCollection(models, rules); for (const model of models) classify(model, rules); }
  if (autoScope || values["accept-suggestions"]) plan = buildPlan(root, models, occupied, warnings, rules, values.template!);
  const text = values.plain ? plainPlan(plan) : JSON.stringify(plan, null, 2) + "\n";
  if (values.output && values.output !== "-") exportPlan(values.output, text, root, occupied);
  else process.stdout.write(text);
  if (plan.summary.BLOCKED) process.exitCode = 2;
}

