    checked.clear(); proposalIndex = 0; evidenceExpanded = false;
    panel = "proposals"; refresh(true); setFocus(true); updateDetail(true);
    tell("Choose values with Up/Down and Space. Enter accepts; Escape returns.");
  }
  function acceptSelected() {
    const model = selectedModel();
    if (!model) return;
    if (isBusy()) { tell("Wait for lookup completion, or Escape to cancel before accepting."); return; }
    if (rules.ignored.includes(model.source)) { tell("Restore this ignored bundle with i before accepting."); return; }
    try {
      const selection = groups().filter(group => checked.has(group.key)).map(group => group.proposal);
      if (!selection.length) throw new Error("Select at least one value with Space before accepting.");
      const count = acceptProposals(model, selection, rules);
      checked.clear(); changed(); refresh(true);
      tell(`Accepted ${count} value(s). The move preview is updated; no files changed.`);
    } catch (error) { tell(errorMessage(error)); }
  }
  function rejectSelected() {
    const model = selectedModel(), group = groups()[proposalIndex];
    if (!model || !group) { tell("Select a proposed value first."); return; }
    for (const proposal of group.sources) proposal.status = "rejected";
    rules.accepted[model.source] = (rules.accepted[model.source] ?? []).filter(proposal => proposal.field !== group.proposal.field || proposal.value !== group.proposal.value);
    checked.delete(group.key); changed(); refresh(true);
    tell("Rejected or revoked the highlighted value. Other fields stay unchanged.");
  }
  function acceptAllSuggestions() {
    if (isBusy()) { tell("Wait for lookup completion, or Escape to cancel before accepting."); return; }
    const result = acceptCollection(models, rules);
    if (result.fields) changed();
    checked.clear(); refresh(true);
    tell(`Collection-wide: accepted ${result.fields} values in ${result.changedModels} models; ${result.conflicts} conflicting fields remain.`);
  }
  async function runSuggestions(scope: "all" | "blocked", acceptAfter = false, one?: Model) {
    if (isBusy()) { tell("A metadata lookup is already running."); return; }
    const controller = new AbortController();
    suggestionController = controller;
    const signal = AbortSignal.any([controller.signal, lifetime.signal]);
    if (one) one.recovery.state = "idle";
    changed();
    let lastRender = 0;
    try {
      await suggestCollection(root, one ? [one] : models, rules, one || scope === "all" ? undefined : blockedSources(plan), signal, message => {
        activityText = message;
        if (closed) return;
        activity.content = fitDisplay(message, renderer.width);
        if (Date.now() - lastRender > 80) { refresh(); lastRender = Date.now(); }
      });
      if (!closed && acceptAfter && !signal.aborted) {
        const result = acceptCollection(models, rules);
        if (result.fields) changed();
        tell(`Collection-wide: accepted ${result.fields} values; ${result.conflicts} conflicts remain.`);
      }
      const failed = (one ? [one] : models).filter(model => model.recovery.state === "error").length;
      activityText = signal.aborted ? "Lookup cancelled; completed proposals retained." : failed ? `Lookup finished with ${failed} error(s). Inspect the model status; c retries the selected model.` : "Lookup complete. Review values with p; A accepts unambiguous values across the collection.";
    } catch (error) {
      activityText = signal.aborted ? "Lookup cancelled; completed proposals retained." : `Lookup failed: ${errorMessage(error)}`;
    } finally {
      suggestionController = null;
      if (!closed) refresh(true);
    }
  }
  function retrieveSelected() {
    const model = selectedModel();
    if (!model) { tell("Select a model before querying Civitai."); return; }
    if (rules.ignored.includes(model.source)) { tell("Restore the ignored bundle before retrieving metadata."); return; }
    panel = "proposals"; setFocus(true); updateDetail(true);
    tell("Civitai receives a SHA256 hash, not the model file. Escape cancels the lookup.");
    void runSuggestions("all", false, model);
  }
  function toggleIgnore() {
    const model = selectedModel();
    if (!model) { tell("Select a model before changing its ignore decision."); return; }
    const ignored = rules.ignored.includes(model.source);
    rules.ignored = ignored ? rules.ignored.filter(source => source !== model.source) : [...rules.ignored, model.source];
    checked.clear(); changed(); refresh(true);
    tell(`${ignored ? "Restored" : "Ignored"} ${model.source}. No files changed.`);
  }
  function requestQuit() {
    if (applyController) { stopApply(); return; }
    if (revision !== savedRevision && panel !== "quit") { openPanel("quit"); return; }
    renderer.destroy();
  }
  function startExport() {
    if (isBusy()) { tell("Wait for lookup completion, or Escape to cancel before exporting."); return; }
    openPanel("export");
  }
  function choosePreset() {
    if (presetIndex === 2) { startEdit("template"); return; }
    const next = presets[presetIndex].template;
    if (template !== next) { template = next; changed(); }
    panel = homePanel(); refresh(true); setFocus(view === 3);
    tell("Grouping updated. Review destinations in 3 Move preview.");
  }
  function openSelected() {
    if (panel === "apply") { if (applyController) stopApply(); else void startApply(true); return; }
    if (panel === "quit") return;
    if (panel === "presets") { choosePreset(); return; }
    if (panel === "export") { if (!isBusy()) startEdit("export"); return; }
    if (panel === "proposals") { acceptSelected(); return; }
    const row = rows[selectedIndex], model = selectedModel();
    if (row?.directory) { toggle(); return; }
    if (!model) return;
    const entry = entries.get(model.source)!;
    if (entry.status === "IGNORED") { toggleIgnore(); return; }
    if (entry.status === "BLOCKED" && entry.blockers.some(blocker => blocker.category === "missing-data" || blocker.category === "conflicting-data")) showProposals();
    else { panel = homePanel(); setFocus(true); updateDetail(true); }
  }
  function startEdit(mode: NonNullable<typeof editing>) {
    if (applyController) return;
    if (mode === "apply") {
      if (isBusy()) { tell("Finish or cancel metadata lookup before applying moves."); return; }
      if (executionLocked) { tell("Inspect the last receipt and restart after recovery before applying."); return; }
      if (!plan.summary.MOVE) { tell("There are no eligible MOVE bundles."); return; }
    }
    if (mode === "export" && isBusy()) { tell("Wait for lookup completion before exporting."); return; }
    if (["override", "manual"].includes(mode) && !selectedModel()) { tell("Select a model before editing its data."); return; }
    if (mode === "manual") panel = "proposals";
    editing = mode; editLabel.visible = input.visible = true;
    editLabel.content = mode === "manual" ? "Manual field=value — Enter adds; Escape cancels" : mode === "template" ? "Custom Liquid — Enter validates; Tab completes; Escape cancels" : mode === "override" ? "Override: base model | topic — blank keeps existing value" : mode === "export" ? "New JSON plan path — existing files are refused" : "Search names, tags and paths — blank restores all";
    input.value = mode === "manual" ? `${RECOVERY_FIELDS.find(field => !get(selectedModel()!.context, field)) ?? "topic"}=` : mode === "template" ? template : mode === "search" ? search : mode === "override" ? `${rules.overrides[selectedModel()!.source]?.basemodel ?? ""} | ${rules.overrides[selectedModel()!.source]?.topic ?? ""}` : join(process.env.TMPDIR ?? "/tmp", `lora-plan-${Date.now()}.json`);
    if (mode === "apply") { editLabel.content = "Type APPLY to authorise the configured moves; Escape cancels"; input.value = ""; }
    updateDetail(mode === "apply"); input.focus();
  }
  function finishEdit() {
    const resetScroll = editing === "apply";
    editing = null; input.visible = editLabel.visible = false;
    refresh(); setFocus(panel !== "overview");
    if (resetScroll) updateDetail(true);
  }
  input.on("enter", () => {
    if (!editing) return;
    if (editing === "apply") {
      if (input.value.trim() !== "APPLY") { tell("Type APPLY exactly, or Escape to cancel. No moves started."); return; }
      editing = null; input.visible = editLabel.visible = false;
      void startApply(false);
      return;
    }
    try {
      if (editing === "template") {
        compileTemplate(input.value);
        if (template !== input.value) { template = input.value; changed(); }
        panel = homePanel(); refresh(true);
        tell("Custom grouping saved. Blocked destinations remain visible in the plan.");
      } else if (editing === "search") { search = input.value; panel = homePanel(); }
      else if (editing === "manual") {
        const number = addManualProposal(selectedModel()!, input.value);
        changed(); refresh(true);
        proposalIndex = Math.max(0, groups().findIndex(group => group.sources.includes(selectedModel()!.proposals[number - 1])));
        tell("Manual proposal added. Select it with Space, then Enter to accept.");
      } else if (editing === "override") {
        const parts = input.value.split("|");
        if (parts.length !== 2) throw new Error("Use base model | topic; leave either side blank to keep it.");
        const model = selectedModel()!, override = { ...rules.overrides[model.source] };
        if (parts[0].trim()) override.basemodel = parts[0].trim();
        if (parts[1].trim()) override.topic = parts[1].trim();
        rules.overrides[model.source] = override; changed(); refresh(true);
        tell("Override saved in this session. Export to retain the decision.");
      } else {
        const path = resolve(input.value);
        exportPlan(path, JSON.stringify(plan, null, 2) + "\n", root, occupied);
        savedPath = path; savedRevision = revision; panel = "export";
        tell(`Exported ${path}. The dry-run command is in the export panel.`);
      }
      finishEdit();
    } catch (error) { tell(errorMessage(error)); }
  });
  function toggle(expand?: boolean) {
    const row = rows[selectedIndex]; if (!row) return;
    const set = row.directory ? collapsed : expandedModels;
    const key = row.directory ? `${view}:${row.key}` : row.model?.source;
    if (!key || (!row.directory && !row.key.startsWith("model:"))) return;
    const shouldContain = row.directory ? expand === undefined ? !set.has(key) : !expand : expand === undefined ? !set.has(key) : expand;
    if (shouldContain) set.add(key); else set.delete(key);
    refresh();
  }
  viewTabs.forEach((tab, index) => { tab.onMouseDown = event => {
    if (event.button !== 0 || editing || applyController) return;
    event.preventDefault(); event.stopPropagation(); switchView(index);
  }; });
  templateLine.onMouseDown = event => {
    if (event.button !== 0 || editing || applyController) return;
    event.preventDefault(); openPanel("presets");
  };
  primaryAction.onMouseDown = event => {
    if (event.button !== 0 || editing) return;
    event.preventDefault(); event.stopPropagation(); openSelected();
  };
  treeText.onMouseDown = event => {
    if (event.button !== 0 || applyController) return;
    event.preventDefault(); event.stopPropagation();
    if (editing) { input.focus(); return; }
    const index = Math.floor(event.y - tree.viewport.screenY + tree.scrollTop), row = rows[index];
    if (!row) return;
    setFocus(false); selectRow(index, false);
    const column = event.x - tree.viewport.screenX + tree.scrollLeft, disclosure = 2 + row.depth * 2;
    if (row.directory || (row.key.startsWith("model:") && column >= disclosure && column < disclosure + 2)) toggle();
  };
  renderer.keyInput.on("keypress", key => {
    if (applyController) {
      if (key.name === "escape" || key.name === "q" || (key.ctrl && key.name === "c")) { key.preventDefault(); stopApply(); }
      return;
    }
    if (editing) {
      if (key.name === "escape") { key.preventDefault(); finishEdit(); }
      else if (editing === "apply" && ["pageup", "pagedown"].includes(key.name)) {
        key.preventDefault();
        right.scrollTo(Math.max(0, right.scrollTop + (key.name === "pageup" ? -1 : 1) * Math.max(1, right.viewport.height - 1)));
      }
      else if (key.name === "tab" && editing === "template") {
        key.preventDefault();
        const match = input.value.match(/(\{\{-?\s*)([\w.-]*)$/);
        if (match) {
          const matches = discoverFields(models).filter(field => field.field.startsWith(match[2]));
          if (matches.length === 1) input.value = input.value.slice(0, -match[0].length) + `${match[1]}${matches[0].field} }}`;
          else tell(matches.map(field => field.field).join("  ") || "No matching fields.");
        }
      }
      return;
    }
    if (key.ctrl && key.name === "c") { key.preventDefault(); requestQuit(); return; }
    if (key.ctrl || key.meta) return;
    if (key.name === "q") { requestQuit(); return; }
    if (key.name === "escape") {
      key.preventDefault();
      if (panel !== "overview" && panel !== "apply") returnToOverview();
      else if (isBusy()) { suggestionController?.abort(); tell("Cancelling metadata lookup; completed proposals stay available."); }
      else { setFocus(view === 3); updateDetail(true); }
      return;
    }
    if (panel === "apply") {
      if (key.name === "tab") { key.preventDefault(); setFocus(true); return; }
      if (key.name === "d" || key.name === "return") { key.preventDefault(); void startApply(true); return; }
      if (key.name === "a" && !key.shift) { key.preventDefault(); startEdit("apply"); return; }
      if (key.name === "r") {
        try { rescanCollection(); tell("Collection rescanned. Review the configured moves before applying."); }
        catch (error) { executionLocked = true; tell(`Cannot rescan: ${errorMessage(error)}`); }
        return;
      }
    }
    if (panel === "quit") { if (key.name === "e") startExport(); return; }
    if (panel === "presets") {
      key.preventDefault();
      if (["1", "2", "3"].includes(key.name)) presetIndex = Number(key.name) - 1;
      else if (key.name === "up" || key.name === "down") presetIndex = (presetIndex + (key.name === "up" ? -1 : 1) + presets.length) % presets.length;
      else if (key.name === "return") { choosePreset(); return; }
      updateDetail(true); return;
    }
    if (panel === "export") { if (key.name === "return") { key.preventDefault(); openSelected(); } return; }
    if (key.name === "?" || key.sequence === "?") { key.preventDefault(); if (panel === "commands") returnToOverview(); else openPanel("commands"); return; }
    if (key.name === "A" || (key.name === "a" && key.shift)) { key.preventDefault(); acceptAllSuggestions(); return; }
    if (key.name === "P" || (key.name === "p" && key.shift)) { key.preventDefault(); void runSuggestions("blocked"); return; }
    if (panel === "proposals" && ["up", "down", "home", "end", "space", "return", "a", "x", "v"].includes(key.name)) {
      key.preventDefault();
      const values = groups();
      if (key.name === "return" || key.name === "a") { acceptSelected(); return; }
      if (key.name === "x") { rejectSelected(); return; }
      if (key.name === "v") evidenceExpanded = !evidenceExpanded;
      else if (key.name === "space") {
        const group = values[proposalIndex];
        if (group && group.proposal.status !== "accepted") { if (checked.has(group.key)) checked.delete(group.key); else checked.add(group.key); }
      } else proposalIndex = Math.max(0, Math.min(values.length - 1, key.name === "home" ? 0 : key.name === "end" ? values.length - 1 : proposalIndex + (key.name === "up" ? -1 : 1)));
      updateDetail();
      if (["up", "down", "home", "end"].includes(key.name)) right.scrollTo(Math.max(0, proposalIndex * 2 + 3 - Math.floor(right.viewport.height / 2)));
      return;
    }
    if (["1", "2", "3", "4"].includes(key.name)) { switchView(Number(key.name) - 1); return; }
    if (key.name === "tab") { key.preventDefault(); setFocus(!focusRight); updateDetail(); return; }
    if (key.name === "b") { returnToOverview(); return; }
    if (key.name === "return") { key.preventDefault(); openSelected(); return; }
    if (key.name === "left" && !focusRight) { key.preventDefault(); toggle(false); return; }
    if (key.name === "right" && !focusRight) { key.preventDefault(); toggle(true); return; }
    if (["up", "down", "pageup", "pagedown", "home", "end"].includes(key.name) && !focusRight) {
      key.preventDefault();
      const page = Math.max(1, tree.viewport.height - 1);
      const index = key.name === "home" ? 0 : key.name === "end" ? rows.length - 1 : selectedIndex + (key.name === "up" ? -1 : key.name === "down" ? 1 : key.name === "pageup" ? -page : page);
      selectRow(Math.max(0, Math.min(rows.length - 1, index))); return;
    }
    if (key.name === "t") { key.preventDefault(); presetIndex = 0; openPanel("presets"); }
    else if (key.name === "/" || key.sequence === "/") { key.preventDefault(); startEdit("search"); }
    else if (key.name === "o") { key.preventDefault(); startEdit("override"); }
    else if (key.name === "i") { key.preventDefault(); toggleIgnore(); }
    else if (key.name === "p") { key.preventDefault(); showProposals(); }
    else if (key.name === "m") { key.preventDefault(); startEdit("manual"); }
    else if (key.name === "c") { key.preventDefault(); retrieveSelected(); }
    else if (key.name === "e") { key.preventDefault(); startExport(); }
    else if (key.name === "r") { if (panel === "raw") returnToOverview(); else openPanel("raw"); }
    else if (key.name === "f") { if (panel === "fields") returnToOverview(); else openPanel("fields"); }
    else if (key.name === "s") { filter = (filter + 1) % filters.length; panel = homePanel(); refresh(); }
  });
  const terminate = () => { if (applyController) { exitAfterApply = true; stopApply("SIGTERM"); } else renderer.destroy(); };
  const interrupt = () => { if (applyController) { exitAfterApply = true; stopApply(); } else requestQuit(); };
  const resize = () => { if (!closed) { updateLayout(); updateDetail(); } };
  process.on("SIGTERM", terminate); process.on("SIGINT", interrupt); renderer.on("resize", resize);
  renderer.once("destroy", () => {
    closed = true; lifetime.abort(); suggestionController?.abort(); applyController?.abort();
    process.removeListener("SIGTERM", terminate); process.removeListener("SIGINT", interrupt); renderer.removeListener("resize", resize);
  });
  refresh(); setFocus(false);
  if (warnings.length) tell(`${warnings.length} scan warnings. Select a directory to inspect them.`);
  if (autoScope) setTimeout(() => { if (!closed) void runSuggestions(autoScope, autoAccept); }, 0);
  else if (autoAccept) acceptAllSuggestions();
}

if (import.meta.main) main().catch(error => { console.error(`lora-organise: ${error instanceof Error ? error.message : String(error)}`); process.exitCode = 1; });
