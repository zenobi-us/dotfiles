const MODEL_EXTENSIONS = new Set([".safetensors", ".ckpt", ".pt", ".pth", ".bin"]);
const SIDECARS = [".metadata.json", ".cm-info.json", ".preview.jpeg", ".preview.jpg", ".preview.png", ".preview.webp", ".preview.gif", ".preview.mp4", ".json", ".txt"];
const TOPICS = new Set(["style", "characters", "concept", "artist", "util"]);
const BASE_FIELDS = ["basemodel", "topic", "file", "stem", "ext", "model.name", "model.version", "model.creator", "tags"];

function object(value: unknown): Json | null { return value !== null && typeof value === "object" && !Array.isArray(value) ? value as Json : null; }
function string(value: unknown): string | null { return typeof value === "string" && value.trim() ? value.trim() : null; }
function strings(value: unknown): string[] { return Array.isArray(value) ? value.filter((item): item is string => typeof item === "string") : []; }
function get(value: unknown, path: string): unknown {
  for (const key of path.split(".")) {
    const record = object(value);
    if (!record || !Object.hasOwn(record, key)) return undefined;
    value = record[key];
  }
  return value;
}
function fingerprint(path: string): Fingerprint { const s = lstatSync(path); return { size: s.size, mtimeMs: s.mtimeMs, dev: s.dev, ino: s.ino }; }
function readObject(path: string): Json {
  if (lstatSync(path).size > 16 * 1024 * 1024) throw new Error("JSON sidecar exceeds 16 MiB");
  const result = object(JSON.parse(readFileSync(path, "utf8")));
  if (!result) throw new Error("Expected a JSON object");
  return result;
}
function loadRules(path?: string): Rules {
  const raw = path ? readObject(resolve(path)) : {};
  const rules: Rules = { tagTopics: {}, basemodelAliases: {}, overrides: {}, ignored: [], accepted: {} };
  for (const field of ["tagTopics", "basemodelAliases"] as const) {
    if (raw[field] !== undefined && !object(raw[field])) throw new Error(`rules.${field} must be an object.`);
    for (const [key, value] of Object.entries(object(raw[field]) ?? {})) {
      if (!string(value)) throw new Error(`rules.${field} values must be non-empty strings.`);
      rules[field][field === "tagTopics" ? key.toLowerCase() : key] = value as string;
    }
