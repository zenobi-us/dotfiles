    });
    const directories = new Map<string, Row>();
    const children = new Map<string, Row[]>();
    function add(parent: string, row: Row) { children.set(parent, [...(children.get(parent) ?? []), row]); }
    for (const model of candidates) {
      const entry = entries.get(model.source)!;
      const destination = planView ? entry.status === "IGNORED" ? join("[ignored]", model.source) : entry.destination ?? join("[unresolved]", model.file) : model.source;
      const parts = destination.split(sep);
      let parent = "";
      for (let i = 0; i < parts.length - 1; i++) {
        const key = parts.slice(0, i + 1).join(sep);
        if (!directories.has(key)) {
          const row = { key: `dir:${key}`, name: parts[i], directory: true, depth: i, parent };
          directories.set(key, row); add(parent, row);
        }
        parent = key;
      }
      const label = entry.status === "BLOCKED" ? `BLOCKED: ${[...new Set(entry.blockers.map(blocker => blocker.category))].join(", ")}` : entry.status;
      const pending = model.proposals.filter(proposal => proposal.status === "pending").length;
      const transient = ["queued", "hashing", "fetching", "error", "not-found", "cancelled"].includes(model.recovery.state);
      const accepted = model.proposals.some(proposal => proposal.status === "accepted");
      const badge = `[${transient ? model.recovery.state : pending ? "suggested" : accepted ? "accepted" : model.recovery.state === "idle" ? "local" : model.recovery.state}${pending ? `: ${pending}` : ""}]`;
      add(parent, { key: `model:${model.source}`, name: `${planView || entry.status === "BLOCKED" || entry.status === "IGNORED" ? `[${label}] ` : ""}${parts.at(-1)}`, model, depth: parts.length - 1, parent, tone: entry.status === "BLOCKED" ? "error" : entry.status === "IGNORED" ? "muted" : "normal", badge, badgeTone: recoveryTone(model) });
    }
    rows = [];
    function flatten(parent: string) {
      const sorted = (children.get(parent) ?? []).sort((a, b) => Number(!!b.directory) - Number(!!a.directory) || (a.model?.file ?? a.name).localeCompare(b.model?.file ?? b.name));
      for (const row of sorted) {
        rows.push(row);
        if (row.model) {
          const model = row.model;
          const conflicts = new Set(RECOVERY_FIELDS.filter(field => new Set(model.proposals.filter(proposal => proposal.status === "pending" && proposal.field === field).map(proposal => proposal.value)).size > 1));
          const displayed = new Map<string, { proposal: Proposal; index: number; sources: number }>();
          const reviewRank = { accepted: 3, pending: 2, rejected: 1 };
          model.proposals.forEach((proposal, index) => {
            const key = JSON.stringify([proposal.field, proposal.value]), previous = displayed.get(key);
            if (!previous) displayed.set(key, { proposal, index, sources: 1 });
            else {
              previous.sources++;
              if (reviewRank[proposal.status] > reviewRank[previous.proposal.status]) { previous.proposal = proposal; previous.index = index; }
            }
          });
          for (const { proposal, index, sources } of displayed.values()) {
            const state = proposal.status === "pending" ? conflicts.has(proposal.field) ? "conflict" : "suggested" : proposal.status;
            const tone: TreeTone = proposal.status === "accepted" ? "accepted" : proposal.status === "rejected" ? "muted" : state === "conflict" || proposal.evidence === "heuristic" ? "warning" : "suggested";
            rows.push({ key: `suggestion:${model.source}:${proposal.field}:${proposal.value}`, name: `[${state}] ${proposal.field}: ${proposal.value} (${proposal.evidence}${sources > 1 ? `; ${sources} sources` : ""})`, model, proposalIndex: index, depth: row.depth + 1, parent: row.key, tone });
          }
          if (entries.get(model.source)!.blockers.some(blocker => blocker.category === "missing-data")) for (const field of compileTemplate(template).fields) {
            let value: unknown;
            try { value = liquid.evalValueSync(field, model.context); }
            catch (error) { if (!(error instanceof UndefinedVariableError)) throw error; }
            if ((value === null || value === undefined || value === "") && !model.proposals.some(proposal => proposal.field === field && proposal.status !== "rejected")) rows.push({ key: `missing:${model.source}:${field}`, name: `[missing] ${field}: no suggestion`, model, depth: row.depth + 1, parent: row.key, tone: "error" });
          }
          if (["error", "not-found", "cancelled"].includes(model.recovery.state)) rows.push({ key: `recovery:${model.source}`, name: `[${model.recovery.state}] ${model.recovery.message}`, model, depth: row.depth + 1, parent: row.key, tone: recoveryTone(model) });
        }
        if (row.directory && !collapsed.has(`${planView}:${row.key}`)) flatten(row.key.slice(4));
        if (row.model && expandedModels.has(row.model.source)) for (const companion of row.model.companions.slice(1)) rows.push({ key: `companion:${companion.path}`, name: basename(companion.path), model: row.model, depth: row.depth + 1, parent: row.key });
      }
    }
    flatten("");
    let index = rows.findIndex(row => row.key === previousKey);
    if (index < 0) index = rows.findIndex(row => row.key === `model:${selectedSource}`);
    selectedIndex = Math.max(0, index);
    renderTree();
    title.content = `LoRA Organise — ${planView ? "2 Reorganise" : "1 Explorer"} — ${models.length} models — read-only`;
    templateLine.content = cleanDisplay(`Template [click]: ${template} | ${plan.summary.MOVE} move / ${plan.summary.BLOCKED} blocked / ${plan.summary.IGNORED} ignored`);
    footer.content = `1/2 views  ←/→ expand  Tab pane  / search  q quit\nP auto-suggest blocked  A accept unambiguous  Escape cancel queue\np local  c Civitai  m manual  a accept  x reject  i ignore  e export\ns filter: ${filters[filter]} | search: ${cleanDisplay(search) || "none"} | ${focusRight ? "details" : "tree"}`;
    updateDetail();
  }
  function startEdit(mode: NonNullable<typeof editing>) {
    if (mode === "export" && (bulkProposing || retrieving)) { status.content = "Wait for retrieval to finish, or cancel the queue before exporting."; return; }
    if (["override", "manual", "accept", "reject"].includes(mode) && !selectedModel()) { status.content = "Select a model before editing its data."; return; }
    if (mode === "manual") { proposalView = true; raw = fieldView = false; updateDetail(); }
    editing = mode;
    editLabel.visible = input.visible = true;
    editLabel.content = mode === "manual" ? `Manual field=value; missing: ${RECOVERY_FIELDS.filter(field => !get(selectedModel()!.context, field)).join(", ") || "none"}` : mode === "accept" ? "Accept proposals: 1,3 or 2-4 or all — Enter saves; Escape cancels" : mode === "reject" ? "Reject/revoke proposal number — Enter saves; Escape cancels" : mode === "template" ? "Template — Tab completes fields; Enter saves; Escape cancels" : mode === "override" ? "Override: base model | topic — blank keeps existing override" : mode === "export" ? "Export new JSON plan file (existing files are never replaced)" : "Search filename / name / tags";
    input.value = mode === "manual" ? `${RECOVERY_FIELDS.find(field => !get(selectedModel()!.context, field)) ?? "topic"}=` : mode === "accept" || mode === "reject" ? "" : mode === "template" ? template : mode === "search" ? search : mode === "override" ? `${rules.overrides[selectedModel()!.source]?.basemodel ?? ""} | ${rules.overrides[selectedModel()!.source]?.topic ?? ""}` : join(process.env.TMPDIR ?? "/tmp", `lora-plan-${Date.now()}.json`);
    input.focus();
  }
  function finishEdit() { editing = null; input.visible = editLabel.visible = false; focusRight = false; tree.focus(); refresh(); }
  input.on("enter", () => {
    try {
      if (editing === "template") { compileTemplate(input.value); template = input.value; refresh(true); }
      else if (editing === "search") search = input.value;
      else if (editing === "manual") {
        const number = addManualProposal(selectedModel()!, input.value);
        status.content = `Manual proposal ${number} added. Press a and enter ${number} to accept; no files changed.`;
        refresh(true);
      }
      else if (editing === "accept" || editing === "reject") {
        const model = selectedModel()!;
        if (editing === "accept") {
          const count = acceptProposals(model, input.value, rules);
          status.content = `Accepted ${count} proposal${count === 1 ? "" : "s"}. No files changed.`;
        } else {
          if (!/^[1-9]\d*$/.test(input.value.trim())) throw new Error("Enter a proposal number from the displayed list.");
          const proposal = model.proposals[Number(input.value.trim()) - 1];
          if (!proposal) throw new Error("No proposal has that number.");
          proposal.status = "rejected";
          rules.accepted[model.source] = (rules.accepted[model.source] ?? []).filter(item => item.field !== proposal.field || item.value !== proposal.value || item.source !== proposal.source);
        }
        refresh(true);
      }
      else if (editing === "override") {
        const parts = input.value.split("|");
        if (parts.length !== 2) throw new Error("Use base model | topic; leave either side blank to keep it.");
        const model = selectedModel()!, override = { ...rules.overrides[model.source] };
        if (parts[0].trim()) override.basemodel = parts[0].trim();
        if (parts[1].trim()) override.topic = parts[1].trim();
        rules.overrides[model.source] = override; refresh(true);
      } else if (editing === "export") {
        exportPlan(input.value, JSON.stringify(plan, null, 2) + "\n", root, occupied);
        status.content = cleanDisplay(`Exported ${input.value}. No model files changed.`);
      }
      finishEdit();
    } catch (error) { status.content = cleanDisplay(error instanceof Error ? error.message : String(error)); }
  });
  templateLine.onMouseDown = event => {
    if (event.button !== 0 || editing) return;
    event.preventDefault();
    startEdit("template");
  };
  treeText.onMouseDown = event => {
    if (event.button !== 0) return;
    event.preventDefault();
    event.stopPropagation();
    if (editing) { input.focus(); return; }
    const index = Math.floor(event.y - tree.viewport.screenY + tree.scrollTop);
    const row = rows[index];
    if (!row) return;
    focusRight = false;
    tree.focus();
    selectRow(index, false);
    const column = event.x - tree.viewport.screenX + tree.scrollLeft;
    const disclosure = 2 + row.depth * 2;
    if (row.directory || (row.key.startsWith("model:") && column >= disclosure && column < disclosure + 2)) toggle();
    else refresh();
  };
  function toggle(expand?: boolean) {
    const row = rows[selectedIndex]; if (!row) return;
    if (row.directory) {
      const key = `${planView}:${row.key}`;
      if (expand === true) collapsed.delete(key); else if (expand === false) collapsed.add(key); else if (collapsed.has(key)) collapsed.delete(key); else collapsed.add(key);
    } else if (row.model && row.key.startsWith("model:")) {
      if (expand === true) expandedModels.add(row.model.source); else if (expand === false) expandedModels.delete(row.model.source); else if (expandedModels.has(row.model.source)) expandedModels.delete(row.model.source); else expandedModels.add(row.model.source);
    }
    refresh();
  }
  renderer.keyInput.on("keypress", key => {
    if (editing) {
      if (key.name === "escape") { key.preventDefault(); finishEdit(); }
      else if (key.name === "tab" && editing === "template") {
        key.preventDefault();
        const match = input.value.match(/(\{\{-?\s*)([\w.-]*)$/);
        if (match) {
          const matches = discoverFields(models).filter(field => field.field.startsWith(match[2]));
          if (matches.length === 1) input.value = input.value.slice(0, -match[0].length) + `${match[1]}${matches[0].field} }}`;
          else status.content = matches.map(field => field.field).join("  ") || "No matching fields.";
        }
      }
      return;
    }
    if (key.ctrl || key.meta) return;
    if (key.name === "q") { renderer.destroy(); return; }
    if (key.name === "escape" && bulkProposing) { key.preventDefault(); suggestionController?.abort(); return; }
    if (key.name === "A" || (key.name === "a" && key.shift)) { key.preventDefault(); acceptAllSuggestions(); return; }
    if (key.name === "1" || key.name === "2") { planView = key.name === "2"; fieldView = raw = proposalView = false; rows = []; refresh(); }
    else if (key.name === "tab") { key.preventDefault(); focusRight = !focusRight; (focusRight ? right : tree).focus(); refresh(); }
    else if (key.name === "left" && !focusRight) { key.preventDefault(); toggle(false); }
    else if (key.name === "right" && !focusRight) { key.preventDefault(); toggle(true); }
    else if (["up", "down", "pageup", "pagedown", "home", "end", "return"].includes(key.name) && !focusRight) {
      key.preventDefault();
      if (key.name === "return") toggle();
      else {
        const page = Math.max(1, tree.viewport.height - 1);
        const index = key.name === "home" ? 0 : key.name === "end" ? rows.length - 1 : selectedIndex + (key.name === "up" ? -1 : key.name === "down" ? 1 : key.name === "pageup" ? -page : page);
        selectRow(Math.max(0, Math.min(rows.length - 1, index)));
      }
    }
    else if (key.name === "t") { key.preventDefault(); startEdit("template"); }
    else if (key.name === "/" || key.sequence === "/") { key.preventDefault(); startEdit("search"); }
    else if (key.name === "o") { key.preventDefault(); startEdit("override"); }
    else if (key.name === "i") { key.preventDefault(); toggleIgnore(); }
    else if (key.name === "P" || (key.name === "p" && key.shift)) { key.preventDefault(); void runAutoSuggestions("blocked"); }
    else if (key.name === "p") { key.preventDefault(); showProposals(); }
    else if (key.name === "m") { key.preventDefault(); startEdit("manual"); }
    else if (key.name === "c") { key.preventDefault(); void retrieveSelected(); }
    else if (key.name === "a" && proposalView) { key.preventDefault(); startEdit("accept"); }
    else if (key.name === "x" && proposalView) { key.preventDefault(); startEdit("reject"); }
    else if (key.name === "b" && proposalView) { key.preventDefault(); proposalView = false; updateDetail(); }
    else if (key.name === "e") { key.preventDefault(); startEdit("export"); }
    else if (key.name === "r") { raw = !raw; fieldView = proposalView = false; updateDetail(); }
    else if (key.name === "f") { fieldView = !fieldView; raw = proposalView = false; updateDetail(); }
    else if (key.name === "s") { filter = (filter + 1) % filters.length; refresh(); }
  });
  const terminate = () => renderer.destroy();
  process.once("SIGTERM", terminate);
  renderer.on("destroy", () => process.removeListener("SIGTERM", terminate));
  const pending = models.reduce((count, model) => count + model.proposals.filter(proposal => proposal.status === "pending").length, 0);
  status.content = warnings.length ? `${warnings.length} scan warnings; select a directory to inspect.` : pending ? `${pending} pending proposals available. Press p to review; no values accepted.` : "No files will be moved. Export a plan with e.";
  refresh(); tree.focus();
  if (autoScope) setTimeout(() => { if (!closed) void runAutoSuggestions(autoScope, autoAccept); }, 0);
  else if (autoAccept) acceptAllSuggestions();
}

if (import.meta.main) main().catch(error => { console.error(`lora-organise: ${error instanceof Error ? error.message : String(error)}`); process.exitCode = 1; });
