.mise/conf.d/devtools-pi/agent/extensions/share/webapp/.tanstack/
.mise/conf.d/devtools-pi/agent/extensions/share/webapp/.cta.json
.mise/conf.d/devtools-pi/agent/extensions/share/webapp/.vscode/

# Pi agent runtime/auth/cache files
/.mise/conf.d/devtools-pi/agent/auth.json
/.mise/conf.d/devtools-pi/agent/.pi/agent/auth.json
/.mise/conf.d/devtools-pi/agent/cache/
/.mise/conf.d/devtools-pi/agent/sessions/
