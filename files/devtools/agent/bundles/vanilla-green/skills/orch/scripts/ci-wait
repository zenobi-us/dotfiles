#!/usr/bin/env -S mise x -- bun --install=fallback
import { json, run } from "./lib/runtime.ts";
const a = process.argv.slice(2); const outputJson = a.includes("--json"); if (a.includes("--help") || a.includes("-h")) { console.log("Usage: ci-wait PR [poll_interval] [max_wait] [--json]"); process.exit(0); } const pr = a.find((x) => /^\d+$/.test(x)); if (!pr) { console.error("Usage: ci-wait PR [poll_interval] [max_wait] [--json]"); process.exit(2); }
const result = run(["gh", "pr", "checks", pr, "--json", "name,state,completedAt"]).stdout; let checks: any[] = []; try { checks = JSON.parse(result); } catch { checks = []; } const pending = checks.filter((x) => !["SUCCESS", "FAILURE", "CANCELLED", "SKIPPED"].includes(x.state)); const failed = checks.filter((x) => ["FAILURE", "CANCELLED"].includes(x.state)); const passed = checks.filter((x) => ["SUCCESS", "SKIPPED"].includes(x.state)); const verdict = pending.length ? "pending" : failed.length ? "fail" : passed.length ? "pass" : "pending"; const status = pending.length ? "timeout" : "complete"; if (outputJson) json({ status, verdict, elapsed_seconds: 0, pending_checks: pending, failed_checks: failed, passed_checks: passed }); else console.log(verdict === "pass" ? "CI passed" : verdict === "fail" ? "CI failed:" : "CI timeout after 0s (verdict: pending)"); process.exit(verdict === "pass" ? 0 : 1);
