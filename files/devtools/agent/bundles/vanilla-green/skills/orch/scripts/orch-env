#!/usr/bin/env -S mise x -- bun --install=fallback
import { envValue, projectRoot } from "./lib/runtime.ts";
const [key, fallback = ""] = process.argv.slice(2);
if (!key) { console.error("Usage: orch-env VARIABLE DEFAULT"); process.exit(2); }
const value = envValue(projectRoot(), key, fallback);
console.log(/^\d+$/.test(fallback) && !/^\d+$/.test(value) ? fallback : value);
