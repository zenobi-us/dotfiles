#!/usr/bin/env -S mise x -- bun --install=fallback
import { existsSync } from "node:fs";
import { projectRoot, run, json } from "./lib/runtime.ts";
const args = process.argv.slice(2); const outputJson = args.includes("--json"); const positional = args.filter((x) => !x.startsWith("-")); let tracker = "", repo = "", issue = ""; const ref = positional[0] === "github" ? positional[1] : positional[0]; const match = ref?.match(/^([^#\s]+\/[^#\s]+)#(\d+)$/); if (match) { tracker = "github"; repo = match[1]; issue = `issue-${match[2]}`; } else { issue = ref ?? run(["git", "branch", "--show-current"]).stdout.match(/(?:[A-Z]+-\d+|issue-\d+)/i)?.[0] ?? ""; tracker = issue.startsWith("issue-") ? "github" : issue ? "linear" : ""; }
const root = projectRoot(); const branch = run(["git", "branch", "--show-current"], { cwd: root }).stdout.trim(); const language = existsSync(`${root}/Cargo.toml`) ? "rust" : existsSync(`${root}/package.json`) ? "node" : existsSync(`${root}/go.mod`) ? "go" : existsSync(`${root}/pyproject.toml`) ? "python" : ""; const result = { project_root: root, branch, issue_id: issue, tracker, repo, platform: process.platform, language, is_worktree: run(["git", "rev-parse", "--git-dir"]).stdout.trim() !== ".git", linear_auth: { ok: false, error: "not checked" }, github_auth: { ok: false, error: "not checked" } };
if (outputJson) json(result); else { console.log(`Orch session: ${root}`); console.log(`Branch: ${branch || "detached"}`); console.log(`Issue: ${issue || "none"}`); console.log(`Tracker: ${tracker || "none"}`); console.log(`Language: ${language || "unknown"}`); }
