#!/usr/bin/env -S mise x -- bun --install=fallback
import { existsSync } from "node:fs";
import { join } from "node:path";
import { json, run } from "./lib/runtime.ts";
if (process.argv.includes("--help") || process.argv.includes("-h")) { console.log("Usage: codex-app-agent-preflight [WORKTREE]"); process.exit(0); }
const worktree = process.argv[2] ?? ".";
const rootResult = run(["git", "-C", worktree, "rev-parse", "--show-toplevel"]);
if (rootResult.code !== 0) { json({ status: "error", severity: "error", ok: false, requires_confirmation: false, message: "not inside a git repository", tracked_agents: 0, visible_agents: 0 }); process.exit(1); }
const root = rootResult.stdout.trim();
const tracked = run(["git", "-C", root, "ls-files", ".codex/agents/*.toml"]).stdout.trim().split("\n").filter(Boolean).length;
const agentDir = join(root, ".codex", "agents");
const visible = existsSync(agentDir) ? [...new Bun.Glob("*.toml").scanSync({ cwd: agentDir })].length : 0;
const warning = tracked === 0;
json({ status: warning ? (visible ? "untracked" : "missing") : "ok", severity: warning ? "warning" : "info", ok: !warning, requires_confirmation: warning, message: warning ? (visible ? "generated Codex agents exist locally but are not tracked" : "no tracked generated Codex agents found at .codex/agents/*.toml") : "tracked Codex generated agents are available to app-created worktrees", repo_root: root, tracked_agents: tracked, visible_agents: visible });
