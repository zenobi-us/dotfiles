#!/usr/bin/env -S mise x -- bun --install=fallback
import { run, fail } from "./lib/runtime.ts";
const [command = "help", arg = ".", pattern] = process.argv.slice(2);
if (["help", "--help", "-h"].includes(command)) { console.log(`Usage: git-context <branch|head|issue-from-branch|repo-root|common-root|timestamp> [worktree]`); process.exit(0); }
if (command === "timestamp") { const format = arg === "." ? "compact" : arg; if (format === "epoch") console.log(Math.floor(Date.now() / 1000)); else if (format === "compact") console.log(new Date().toISOString().replace(/[-:TZ.]/g, "").slice(0, 15)); else fail(`Error: unknown timestamp format '${format}'`, 2); process.exit(0); }
const gitArgs = command === "branch" ? ["branch", "--show-current"] : command === "head" ? ["rev-parse", "HEAD"] : command === "repo-root" ? ["rev-parse", "--show-toplevel"] : command === "common-root" ? ["rev-parse", "--git-common-dir"] : ["branch", "--show-current"];
const result = run(["git", "-C", arg, ...gitArgs]);
if (result.code !== 0) fail(result.stderr.trim() || `git-context: git command failed`);
if (command === "issue-from-branch") { const p = new RegExp(pattern ?? process.env.GH_ISSUE_PATTERN ?? "([A-Z]+-[0-9]+|issue-[0-9]+)", "i"); const match = result.stdout.match(p); if (!match) fail(`Error: no issue id matched branch '${result.stdout.trim()}'`); console.log(match[0].startsWith("issue-") ? match[0].toLowerCase() : match[0].toUpperCase()); }
else if (command === "common-root") console.log(result.stdout.trim().endsWith("/.git") ? result.stdout.trim().slice(0, -5) : run(["git", "-C", arg, "rev-parse", "--show-toplevel"]).stdout.trim());
else console.log(result.stdout.trim());
