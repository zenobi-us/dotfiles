#!/usr/bin/env -S mise x -- bun --install=fallback
import { envValue, json, projectRoot, run } from "./lib/runtime.ts";
const a = process.argv.slice(2); const outputJson = a.includes("--json"); if (a.includes("--help") || a.includes("-h")) { console.log("Usage: approval-wait PR [poll_interval] [max_wait] [--json] [--mode approval|review]"); process.exit(0); } if (a.includes("--resolve-mode")) { const mode = envValue(projectRoot(), "PR_REVIEW_GATE", "") || (envValue(projectRoot(), "PR_APPROVAL_GATE", "") === "off" ? "off" : "approval"); console.log(["approval", "review", "off"].includes(mode) ? mode : "approval"); process.exit(0); }
const pr = a.find((x) => /^\d+$/.test(x)); if (!pr) { console.error("Usage: approval-wait PR [poll_interval] [max_wait] [--json] [--mode approval|review]"); process.exit(2); } const mode = a.includes("--mode") ? a[a.indexOf("--mode") + 1] : "approval"; const result = run(["gh", "pr", "view", pr, "--json", "reviewDecision,latestReviews,headRefOid" ]); let status = "timeout", error = ""; let data: any = {}; try { data = JSON.parse(result.stdout); } catch { error = result.stderr.trim() || "invalid GitHub response"; status = "error"; }
if (result.code === 0) { const reviews = data.latestReviews ?? []; const changes = reviews.filter((x: any) => x.state === "CHANGES_REQUESTED").length; const approvals = reviews.filter((x: any) => x.state === "APPROVED").length; if (changes) status = "changes_requested"; else if (mode === "review" ? reviews.length > 0 : data.reviewDecision === "APPROVED" || approvals > 0) status = mode === "review" ? "reviewed" : "approved"; const resultData = { status, review_decision: data.reviewDecision ?? "", approvals, changes_requested: changes, unresolved_count: 0, elapsed_seconds: 0, ...(mode === "review" ? { mode, head_sha: data.headRefOid ?? "", reviews_at_head: reviews.length } : {}), ...(error ? { error } : {}) }; if (outputJson) json(resultData); else console.log(status === "approved" ? "Approval approved" : status === "reviewed" ? "Review received" : `Approval ${status}`); process.exit(status === "approved" || status === "reviewed" ? 0 : 1); }
if (outputJson) json({ status, review_decision: "", approvals: 0, changes_requested: 0, unresolved_count: 0, elapsed_seconds: 0, error }); else console.error(`Approval error: ${error}`); process.exit(3);
