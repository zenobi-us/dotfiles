#!/usr/bin/env -S mise x -- bun --install=fallback
import { existsSync, mkdirSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { atomicJson, epoch, fail, getPath, json, setPath } from "./lib/runtime.ts";

const HELP = `Usage: workflow-state [--state-dir PATH] <command> <issue_id> [args...]
Commands: init, exists, path, get, set, update, append, increment, set-git-head, set-now, new-round-id`;
const argv = [...process.argv.slice(2)];
let stateDir = process.env.ORCH_STATE_DIR ?? "tmp";
if (argv[0] === "--state-dir") { stateDir = argv[1] ?? fail("--state-dir requires a path argument", 2); argv.splice(0, 2); }
else if (argv[0]?.startsWith("--state-dir=")) stateDir = argv.shift()!.slice(12);
const command = argv.shift() ?? "help";
const statePath = (id: string) => join(stateDir, `workflow-state-${id}.json`);
function resolved(id: string): string {
  const exact = statePath(id);
  if (/^\d+$/.test(id)) {
    const normal = statePath(`issue-${id}`);
    if (existsSync(exact) && existsSync(normal)) fail(`Error: ambiguous state key '${id}': both ${exact} and ${normal} exist`, 2);
    if (!existsSync(exact) && existsSync(normal)) return normal;
  }
  return exact;
}
function read(id: string): any { const path = resolved(id); if (!existsSync(path)) fail(`Error: State file not found: ${path}`, 1); return JSON.parse(readFileSync(path, "utf8")); }
function parseValue(raw: string): any { if (/^(true|false|null)$/.test(raw) || /^-?\d+(\.\d+)?$/.test(raw) || raw.startsWith("{") || raw.startsWith("[")) return JSON.parse(raw); return raw; }
function applyExpression(value: any, expression: string): any {
  for (const part of expression.split(/\s*\|\s*/)) {
    const assignment = part.match(/^\.?([\w.]+)\s*(\+=|=)\s*(.*)$/);
    if (!assignment) continue;
    const [, path, op, raw] = assignment; const next = raw === "." ? value : parseValue(raw);
    if (op === "=") setPath(value, path, next);
    else { const old = getPath(value, path); setPath(value, path, (Array.isArray(old) ? old : Number(old ?? 0)) instanceof Array ? [...(old ?? []), ...(Array.isArray(next) ? next : [next])] : Number(old ?? 0) + Number(next ?? 1)); }
  }
  return value;
}
async function main() {
  if (["help", "-h", "--help"].includes(command)) return console.log(HELP);
  const id = argv.shift(); if (!id) fail("issue_id is required", 2);
  if (command === "path") return console.log(resolved(id));
  if (command === "exists") { const wantJson = argv[0] === "--json"; if (wantJson) argv.shift(); const path = resolved(id); if (wantJson) return json({ issue_id: id, path, exists: existsSync(path) }); process.exit(existsSync(path) ? 0 : 1); }
  if (command === "init") { const opts: Record<string, string> = {}; while (argv.length) { const k = argv.shift()!; opts[k] = argv.shift() ?? ""; } mkdirSync(stateDir, { recursive: true }); const path = statePath(id); const state = { issue_id: id, sub_issues: JSON.parse(opts["--sub-issues"] ?? "[]"), agent: opts["--agent"] ?? "", worktree: opts["--worktree"] ?? "", branch: opts["--branch"] ?? "", team_name: opts["--team"] ?? "", qa_labels: JSON.parse(opts["--qa-labels"] ?? "[]"), child_sessions: {}, review_agents: [], review_agent_ids: {}, review_agent_runtime_types: {}, pre_delegate_sha: null, skip_qa: false, cycles: 0, json_paths: [], fixed_items: [], escalated_items: [], audit_issues_created: [], pr_review_baseline: null, pr_comment_review: { iterations: 0, fixes: [], issues_created: [], skipped: [] } }; await atomicJson(path, state); return console.log(path); }
  const state = read(id); const path = resolved(id);
  if (command === "get") { const raw = getPath(state, argv[0] ?? "."); return console.log(raw === undefined ? "null" : typeof raw === "string" || typeof raw === "number" || typeof raw === "boolean" ? raw : JSON.stringify(raw)); }
  if (command === "set" || command === "append" || command === "increment") { const field = argv.shift(); if (!field) fail("field is required", 2); if (command === "set") setPath(state, field, parseValue(argv.join(" "))); else if (command === "increment") setPath(state, field, Number(getPath(state, field) ?? 0) + 1); else { const current = getPath(state, field); setPath(state, field, [...(Array.isArray(current) ? current : []), parseValue(argv.join(" "))]); } await atomicJson(path, state); return; }
  if (command === "set-git-head") { const field = argv.shift()!; const result = Bun.spawnSync(["git", "-C", argv[0] ?? ".", "rev-parse", "HEAD"], { stdout: "pipe" }); setPath(state, field, new TextDecoder().decode(result.stdout).trim()); await atomicJson(path, state); return; }
  if (command === "set-now") { setPath(state, argv.shift()!, epoch()); await atomicJson(path, state); return; }
  if (command === "new-round-id") { const value = `${Date.now()}-${Math.floor(Math.random() * 32768)}`; setPath(state, argv.shift()!, value); await atomicJson(path, state); console.log(value); return; }
  if (command === "update") { applyExpression(state, argv.join(" ")); await atomicJson(path, state); return; }
  fail(`Unknown command: ${command}`, 1);
}
main().catch((error) => fail(error instanceof Error ? error.message : String(error)));
