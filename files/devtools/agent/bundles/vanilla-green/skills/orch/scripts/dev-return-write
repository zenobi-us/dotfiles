#!/usr/bin/env -S mise x -- bun --install=fallback
import { existsSync, mkdirSync, readFileSync, renameSync } from "node:fs";
import { join, resolve } from "node:path";
const a = process.argv.slice(2); const value = (flag: string) => { const i = a.indexOf(flag); return i < 0 ? "" : a[i + 1] ?? ""; };
if (a.includes("-h") || a.includes("--help")) { console.log("Usage: dev-return-write --worktree PATH --kind implement|fix --issue ID --round-id RID --branch BRANCH --commit SHA --validate STR [--qa-label LABEL]... [--item N DECISION REASONING]..."); process.exit(0); }
const worktree = value("--worktree"), kind = value("--kind"), issue = value("--issue"), round = value("--round-id"), branch = value("--branch"), commit = value("--commit"), validate = value("--validate");
function die(message: string): never { console.error(`dev-return-write: ${message}`); process.exit(2); }
if (!worktree || !existsSync(worktree)) die("--worktree must be an existing directory"); if (!["implement", "fix"].includes(kind)) die("--kind must be implement or fix"); if (!/^[A-Za-z0-9._-]+$/.test(issue) || issue.includes("..")) die("--issue is not path-safe"); if (!/^[A-Za-z0-9._-]+$/.test(round) || round.includes("..")) die("--round-id is not path-safe"); if (!branch || !commit || !validate || !(validate === "pass" || validate.startsWith("FAILING:"))) die("required fields are missing or invalid");
const labels = a.flatMap((x, i) => x === "--qa-label" ? [a[i + 1]] : []).filter(Boolean); const items: any[] = [];
for (let i = 0; i < a.length; i++) if (a[i] === "--item") { const [n, decision, reasoning] = a.slice(i + 1, i + 4); if (!/^\d+$/.test(n ?? "") || !["Applied", "Skipped", "Blocked"].includes(decision) || !reasoning) die("invalid --item"); items.push({ n: Number(n), decision, reasoning }); }
const bundled = a.includes("--bundled"); if ((kind === "fix" || bundled) && !items.length) die("at least one --item is required");
const summaryPath = value("--summary-file"); const summary = summaryPath ? readFileSync(summaryPath, "utf8") : null; const outDir = resolve(worktree, "tmp"); mkdirSync(outDir, { recursive: true }); const out = join(outDir, `dev-return-${issue}-${round}.json`); const tmp = `${out}.${process.pid}.tmp`;
await Bun.write(tmp, JSON.stringify({ schema_version: 1, round_id: round, kind, issue, branch, commit, validate, qa_labels: labels, summary_posted: !a.includes("--no-summary"), summary, bundled, items }, null, 2) + "\n"); renameSync(tmp, out); console.log(out);
