  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giuseppecrj/pi-hrdx-agents.git"
  },
  "bugs": {
    "url": "https://github.com/giuseppecrj/pi-hrdx-agents/issues"
  },
  "homepage": "https://github.com/giuseppecrj/pi-hrdx-agents#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
