{
  "autocompleteMaxVisible": 10,
  "collapseChangelog": true,
  "defaultModel": "gpt-6-luna",
  "defaultProvider": "openai",
  "defaultThinkingLevel": "medium",
  "doubleEscapeAction": "tree",
  "defaultProjectTrust": "always",
  "enableInstallTelemetry": false,
  "hideThinkingBlock": false,
  "lastChangelogVersion": "1.0.2",
  "packages": [
    "npm:@marckrenn/pi-sub-core",
    "./extensions/@zenobius/agent-core",
    "./extensions/@zenobius/creator",
    "./extensions/@zenobius/developer",
    "./extensions/@zenobius/matt-pocock",
    "./extensions/@zenobius/platform",
    "./extensions/@zenobius/researcher",
    "./extensions/@zenobius/writing",
    "./extensions/@zenobius/pi-annotate",
    "./extensions/@zenobius/pi-autoresearch",
    "./extensions/@zenobius/pi-handoff",
    "./extensions/@zenobius/pi-poster",
    "./extensions/@zenobius/sub-limits",
    "npm:pi-add-dir",
    "npm:@mrclrchtr/supi-ask-user",
    "npm:pi-debug-mode",
    {
      "source": "npm:pi-code",
      "extensions": [
        "!extensions/subagent/**",
        "!extensions/skills.ts"
      ]
    },
    "npm:pi-herdr-agents",
    "npm:pi-lens",
    "npm:@earendil-works/pi-voice",
    "npm:@prjct.app/pi-clipboard"
  ],
  "quietStartup": "header",
  "shellCommandPrefix": "eval \"$(mise env -s bash)\"\nshopt -s expand_aliases\neval \"$(grep '^alias ' ~/.zshrc)\"",
  "showHardwareCursor": false,
  "terminal": {
    "clearOnShrink": false,
    "showTerminalProgress": true
  },
  "theme": "system/system",
  "transport": "sse",
  "enableSkillCommands": true,
  "modelThinkingLevels": {
    "openai/gpt-5.5": "medium"
  }
}
