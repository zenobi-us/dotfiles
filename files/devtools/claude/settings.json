{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/zenobius/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "agent-core@zenobius-agent-bundles": true,
    "creator@zenobius-agent-bundles": true,
    "developer@zenobius-agent-bundles": true,
    "matt-pocock@zenobius-agent-bundles": true,
    "platform@zenobius-agent-bundles": true,
    "private-share@zenobius-agent-bundles": true,
    "researcher@zenobius-agent-bundles": true,
    "vanilla-green@zenobius-agent-bundles": true,
    "writing@zenobius-agent-bundles": true,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "zenobius-agent-bundles": {
      "source": {
        "source": "directory",
        "path": "/var/home/zenobius/Projects/dotfiles/files/devtools/agent/bundles"
      }
    }
  },
  "outputStyle": "simple-english-sop",
  "feedbackDrafts": "off",
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      " "
    ]
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:rose-pine-moon"
}
