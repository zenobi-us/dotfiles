
# Font Configuration
font-size = 10
font-family = "JetBrainsMono Nerd Font Mono"

# Window Configuration
window-decoration = false
window-padding-x = 12
window-padding-y = 12
background-opacity = 1.0
# background-blur-radius = 32

# Cursor Configuration
cursor-style = block
cursor-style-blink = true

# Scrollback
scrollback-limit = 3023

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false

# Disable annoying copied to clipboard
app-notifications = no-clipboard-copy,no-config-reload

# Key bindings for common actions
# Preserve Shift+Enter through hrdx for pi multiline input.
keybind = shift+enter=text:\x1b[13;2u
# Send modified arrow keys through to Neovim.
keybind = ctrl+shift+up=csi:1;6A
keybind = ctrl+shift+down=csi:1;6B
#keybind = ctrl+c=copy_to_clipboard
#keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
#keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Material 3 UI elements
unfocused-split-opacity = 0.7
unfocused-split-fill = #44464f

# Tab configuration
gtk-titlebar = false

# Shell integration
shell-integration = none
shell-integration-features = cursor,sudo,title,no-cursor
window-inherit-working-directory = false

# Rando stuff
gtk-single-instance = true
theme = mono-slate

# >>> herdr-radar font block
font-codepoint-map = U+E1A0-U+E1BA=Herdr Agent Icons Max
font-codepoint-map = U+E1C0-U+E1C5=Herdr Agent Icons Max
