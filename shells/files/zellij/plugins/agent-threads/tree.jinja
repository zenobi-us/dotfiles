{%- macro prefix_start(index, total) -%}
{{- "└─ " if index == total - 1 else "├─ " -}}
{%- endmacro -%}

{%- macro prefix_tail(index, total) -%}
{{- "   " if index == total - 1 else "│  " -}}
{%- endmacro -%}

{%- macro prefix_indent(ancestors=[]) -%}
{%- for is_last in ancestors -%}
{{- "   " if is_last else "│  " -}}
{%- endfor -%}
{%- endmacro -%}

{%- macro prefix_line(index, total, ancestors=[], continued=false) -%}
{{- prefix_indent(ancestors) -}}{{- prefix_tail(index, total) if continued else prefix_start(index, total) -}}
{%- endmacro -%}

{%- macro entry(index, total, ancestors=[]) -%}
{%- if caller is defined -%}
{%- set lines = caller() | trim | split("\n") -%}
{%- for line in lines -%}
{{- prefix_line(index, total, ancestors, loop.index0 > 0) -}}{{- line -}}{{ "\n" if not loop.last else "" -}}
{%- endfor -%}
{%- else -%}
{{- prefix_line(index, total, ancestors) -}}
{%- endif -%}
{%- endmacro -%}

{# pipe spacer. kept for older templates; prefer prefix_line(..., continued=true) #}
{%- macro spacer(index, total, indent) -%}
{%- for i in range(indent) -%}
{{- prefix_tail(index, total) -}}
{%- endfor -%}
{%- endmacro -%}
