{% import "./tree.jinja" as tree %}
{%- if agents | length > 0 -%}
  {%- call Flex(shrink=0) -%}
  {{- " Agents " | bold -}}
  {%- endcall -%}
  {%- set spinner_frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"] -%}
  {%- macro spinner(fps=8) -%}{{ spinner_frames[AnimationFrame(fps=fps) % (spinner_frames | length - 1)] }}{%- endmacro -%}
  {%- macro t(text, focused) -%}{{ text | bold if focused else text | dim }}{%- endmacro -%}

  {%- for tab in tabs if tab.agents | length > 0 -%}
    {%- set tab_index = loop.index0 -%}
    {%- set tab_total = loop.length -%}
    {%- set tab_is_last = loop.last -%}
    {%- set tab_label = " %s " | format(tab.tab_name) -%}
    {%- if tab.tab_id is not none -%}
      {%- call Button(on_click=actions.switch_tab(tab.tab_id), focused=false) -%}
      {{- tree.prefix_line(tab_index, tab_total) | dim }}{{- tab_label | bg("index:6") | fg("index:0") if tab.active else tab_label | bg("index:8") | dim -}}
      {%- endcall -%}
    {%- else -%}
      {%- call Flex(shrink=0) -%}
      {{- tree.prefix_line(tab_index, tab_total) | dim }}{{- tab_label | bg("index:6") | fg("index:0") if tab.active else tab_label | bg("index:8") | dim -}}
      {%- endcall -%}
    {%- endif -%}

    {%- for agent in tab.agents -%}
      {%- set agent_is_last = loop.last -%}
      {%- set icon = spinner() if agent.state == "running" else "󰏧" -%}
      {%- set agent_label = "%s %s %s@%s" | format(agent.pane, icon, agent.harness, agent.model) -%}
      {%- call Button(on_click=actions.focus_pane(agent.pane), focused=agent.focused) -%}
        {{- tree.prefix_line(loop.index0, loop.length, [tab_is_last]) | dim }} {{ t(agent_label, agent.focused) }}
        {%- if agent.state == "running" and agent.current_tool %}
          {{ "\n" -}}{{- tree.prefix_line(0, 1, [tab_is_last, agent_is_last]) | dim }} {{ agent.current_tool | dim }}
        {%- endif -%}
      {%- endcall -%}
    {%- endfor -%}

  {%- endfor -%}
{%- endif -%}
